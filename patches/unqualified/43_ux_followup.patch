@@ -0,0 +1,174 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const vm = require("node:vm");
+
+const { readChatGptAuthSession } = require("../electron/chatgpt-auth-session.cjs");
+
+const ORIGIN = "https://chatgpt.com";
+const SESSION_URL = `${ORIGIN}/api/auth/session`;
+const VALID_SESSION = { user: { id: "fixture" }, expires: "2099-01-01T00:00:00Z" };
+const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+function response(body, { status = 200, contentType = "application/json", redirected = false } = {}) {
+  return {
+    ok: status >= 200 && status < 300, status, redirected,
+    headers: { get: name => (name.toLowerCase() === "content-type" ? contentType : null) },
+    json: async () => body,
+  };
+}
+
+// The last handler repeats, so a hung or failing client keeps failing.
+function scripted(...handlers) {
+  const calls = [];
+  const fetchFn = async (url, options) => {
+    calls.push({ url, options });
+    const handler = handlers[Math.min(calls.length, handlers.length) - 1];
+    return typeof handler === "function" ? handler(url, options) : handler;
+  };
+  fetchFn.calls = calls;
+  return fetchFn;
+}
+
+function exactReads(calls, count) {
+  assert.equal(calls.length, count);
+  for (const { url, options } of calls) {
+    assert.equal(url, SESSION_URL);
+    assert.equal(options.method, undefined);
+    assert.equal(options.body, undefined);
+    assert.equal(options.redirect, "error");
+    assert.equal(options.credentials, "include");
+    assert.equal(options.cache, "no-store");
+  }
+}
+
+test("one transient 503 is re-read through the same client and deadline", async () => {
+  const fetchFn = scripted(response(null, { status: 503 }), response(VALID_SESSION));
+  const result = await readChatGptAuthSession(fetchFn, ORIGIN, 5000);
+  assert.deepEqual(result, { sessionAuthenticated: true, sessionCheckError: null });
+  exactReads(fetchFn.calls, 2);
+  assert.equal(fetchFn.calls[0].options.signal, fetchFn.calls[1].options.signal);
+});
+
+test("one transient transport rejection is re-read and stays silent about its cause", async () => {
+  const fetchFn = scripted(async () => { throw new Error("private-transport-secret"); }, response(VALID_SESSION));
+  const result = await readChatGptAuthSession(fetchFn, ORIGIN, 5000);
+  assert.deepEqual(result, { sessionAuthenticated: true, sessionCheckError: null });
+  exactReads(fetchFn.calls, 2);
+  assert.doesNotMatch(JSON.stringify(result), /private-/);
+});
+
+test("persistent failure stops at two reads", async () => {
+  for (const [name, handler] of [
+    ["server", response(null, { status: 503 })],
+    ["transport", async () => { throw new Error("private-transport-secret"); }],
+  ]) {
+    const fetchFn = scripted(handler);
+    const result = await readChatGptAuthSession(fetchFn, ORIGIN, 5000);
+    exactReads(fetchFn.calls, 2);
+    assert.equal(result.sessionAuthenticated, false, name);
+    assert.doesNotMatch(JSON.stringify(result), /private-/, name);
+    if (name === "server") assert.match(result.sessionCheckError, /HTTP 503/);
+  }
+});
+
+test("denials and settled payloads are read once", async () => {
+  const cases = [
+    ["401", () => response(null, { status: 401 })],
+    ["403", () => response(null, { status: 403 })],
+    ["429", () => response(null, { status: 429 })],
+    ["expired", () => response({ ...VALID_SESSION, expires: "2000-01-01T00:00:00Z" })],
+    ["guest", () => response({})],
+    ["error payload", () => response({ ...VALID_SESSION, error: { code: "unavailable" } })],
+    ["html", () => response(null, { contentType: "text/html" })],
+    ["invalid json", () => ({ ...response(null), json: async () => { throw new SyntaxError("private-body"); } })],
+    ["non-object body", () => response(["private-body"])],
+    ["followed redirect", () => response(VALID_SESSION, { redirected: true })],
+  ];
+  for (const [name, handler] of cases) {
+    const fetchFn = scripted(handler);
+    const result = await readChatGptAuthSession(fetchFn, ORIGIN, 5000);
+    exactReads(fetchFn.calls, 1);
+    assert.equal(result.sessionAuthenticated, false, name);
+    assert.doesNotMatch(JSON.stringify(result), /private-/, name);
+  }
+});
+
+test("a rejected redirect is never followed, never leaked, and stays unauthenticated", async () => {
+  const fetchFn = scripted(async (_url, options) => {
+    assert.equal(options.redirect, "error");
+    throw new TypeError("private-redirect-target");
+  });
+  const result = await readChatGptAuthSession(fetchFn, ORIGIN, 5000);
+  assert.equal(result.sessionAuthenticated, false);
+  assert.ok(fetchFn.calls.length <= 2);
+  assert.doesNotMatch(JSON.stringify(result), /private-/);
+});
+
+test("the deadline aborts the read and no attempt follows it", async () => {
+  const fetchFn = scripted((_url, { signal }) => new Promise((_, reject) => {
+    signal.addEventListener("abort", () => reject(new Error("private-abort")));
+  }));
+  const result = await readChatGptAuthSession(fetchFn, ORIGIN, 80);
+  assert.equal(fetchFn.calls.length, 1);
+  assert.equal(result.sessionAuthenticated, false);
+  assert.match(result.sessionCheckError, /timed out/);
+  assert.doesNotMatch(JSON.stringify(result), /private-/);
+});
+
+test("a re-read shares the first read's remaining budget", async () => {
+  const fetchFn = scripted(async () => { await delay(40); return response(null, { status: 503 }); },
+    (_url, { signal }) => new Promise((_, reject) => signal.addEventListener("abort", () => reject(new Error("private-abort")))));
+  const started = Date.now();
+  const result = await readChatGptAuthSession(fetchFn, ORIGIN, 200);
+  const elapsed = Date.now() - started;
+  assert.equal(fetchFn.calls.length, 2);
+  assert.match(result.sessionCheckError, /timed out/);
+  assert.ok(elapsed < 400, `elapsed ${elapsed}ms`);
+});
+
+test("parallel readers keep independent clients and outcomes", async () => {
+  const transient = scripted(async () => { await delay(20); return response(null, { status: 503 }); }, response(VALID_SESSION));
+  const denied = scripted(() => response(null, { status: 401 }));
+  const [ok, signedOut] = await Promise.all([
+    readChatGptAuthSession(transient, ORIGIN, 3000),
+    readChatGptAuthSession(denied, ORIGIN, 3000),
+  ]);
+  assert.deepEqual(ok, { sessionAuthenticated: true, sessionCheckError: null });
+  assert.deepEqual(signedOut, { sessionAuthenticated: false, sessionCheckError: null });
+  exactReads(transient.calls, 2);
+  exactReads(denied.calls, 1);
+  assert.notEqual(transient.calls[0].options.signal, denied.calls[0].options.signal);
+});
+
+// browser-host injects this function with .toString(), so it must run with no module scope.
+function pageReader(source = readChatGptAuthSession) {
+  const state = { timers: [], controllers: 0 };
+  const context = {
+    AbortController: class extends AbortController { constructor() { super(); state.controllers += 1; } },
+    setTimeout: (callback, ms) => { state.timers.push(ms); return setTimeout(callback, ms); },
+    clearTimeout,
+  };
+  return { read: vm.runInNewContext(`(${source.toString()})`, context), state };
+}
+
+test("the serialized function recovers in a bare page context with one deadline", async () => {
+  const { read, state } = pageReader();
+  const fetchFn = scripted(response(null, { status: 503 }), response(VALID_SESSION));
+  const result = await read(fetchFn, ORIGIN, 5000);
+  assert.equal(result.sessionAuthenticated, true);
+  assert.equal(result.sessionCheckError, null);
+  exactReads(fetchFn.calls, 2);
+  assert.equal(state.controllers, 1);
+  assert.deepEqual(state.timers, [5000]);
+});
+
+test("the serialized function spends one deadline across both reads", async () => {
+  const { read, state } = pageReader();
+  const fetchFn = scripted(response(null, { status: 503 }),
+    (_url, { signal }) => new Promise((_, reject) => signal.addEventListener("abort", () => reject(new Error("private-abort")))));
+  const result = await read(fetchFn, ORIGIN, 100);
+  assert.equal(fetchFn.calls.length, 2);
+  assert.match(result.sessionCheckError, /timed out/);
+  assert.equal(state.controllers, 1);
+  assert.deepEqual(state.timers, [100]);
+});
