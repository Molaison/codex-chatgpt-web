+    for (const change of [
+      (v:MultipartCheckpoint)=>{v.transactionId="other";},(v:MultipartCheckpoint)=>{v.inputHash="b".repeat(64);},
+      (v:MultipartCheckpoint)=>{v.accountId="other";},(v:MultipartCheckpoint)=>{v.lease.helperPid++;},
+      (v:MultipartCheckpoint)=>{v.pendingStage!.submittedText="changed";},
+    ]) {const altered=structuredClone(c);change(altered);expect(()=>f.operation.saveMultipartCheckpoint(altered)).toThrow();}
+    c.pendingStage!.phase="send_activated";f.operation.saveMultipartCheckpoint(c);accept(c);f.operation.saveMultipartCheckpoint(c);acknowledge(c);f.operation.saveMultipartCheckpoint(c);
+    const altered=structuredClone(c);altered.acknowledgedStages[0]!.acknowledgement="wrong";
+    expect(()=>f.operation.saveMultipartCheckpoint(altered)).toThrow("history");
