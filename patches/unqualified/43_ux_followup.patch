+    c.pendingStage!.phase="send_activated"; f.operation.saveMultipartCheckpoint(c);
+    expect(new OperationJournal(f.root).read<OperationRecord>(f.record.executionKey)!.multipart!.pendingStage!.phase).toBe("send_activated");
+    const resumed=new DurableOperation(new OperationJournal(f.root),new OperationJournal(f.root).read<OperationRecord>(f.record.executionKey)!);
+    expect(()=>resumed.saveMultipartCheckpoint({...c,pendingStage:{...c.pendingStage!,phase:"prepared"}})).toThrow("replayed");
+    accept(c); resumed.saveMultipartCheckpoint(c); acknowledge(c); resumed.saveMultipartCheckpoint(c);
+    c.pendingStage={index:2,kind:"stage",phase:"prepared",submittedText:"inert part 2",acknowledgement:"ACK 2",initialTurnIdentities:["user1","assistant1"]};
+    resumed.saveMultipartCheckpoint(c);
+    expect(new OperationJournal(f.root).read<OperationRecord>(f.record.executionKey)!.multipart).toEqual(c);
+    expect(resumed.record.submission).toBe("prepared");
+    expect(resumed.record.generation).toBe("not_started");
+    expect(resumed.record.observation).toBeUndefined();
+  } finally {rmSync(f.root,{recursive:true,force:true});}
+});
+
