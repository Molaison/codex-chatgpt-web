+import { expect, test } from "bun:test";
+import { nativeReceiptRecoveryInput } from "../src/adapters/chatgpt-web/index";
+import { compileChatGptWebPrompt } from "../src/adapters/chatgpt-web/prompt";
+import { operationDigest } from "../src/adapters/chatgpt-web/operation-journal";
+import { CHATGPT_WEB_MODEL_ID } from "../src/adapters/chatgpt-web/model";
+import type { CompletedReceiptRecovery } from "../src/adapters/chatgpt-web/turn-broker";
+import type { CodexParsedRequest } from "../src/types";
+
+test("receipt context preserves freeform/result errors, replaces stale copies and allows distinct steps in prompt", () => {
+  const parsed: CodexParsedRequest = { modelId: CHATGPT_WEB_MODEL_ID, stream: true, options: { reasoning: "high" },
+    context: { systemPrompt: ["scope unchanged"], messages: [{ role: "user", content: "A then B", timestamp: 1 }] } };
+  const input = "*** Begin Patch\n*** Add File: effect\n+A\n*** End Patch";
+  const result = { content: [{ type: "text", text: "patch refused" }], isError: true };
+  const proof = { call_A: operationDigest(JSON.stringify(result)) };
+  const recovery: CompletedReceiptRecovery = { token: "turn_12345678901234567890123456789012", receipts: [{
+    request: { callId: "call_A", wireName: "apply_patch", freeform: true, input }, result, resultHash: proof.call_A }] };
+  const recovered = nativeReceiptRecoveryInput(parsed, recovery, proof);
+  const action = recovered.context.messages[1]!;
+  expect(action.role).toBe("assistant");
+  if (action.role !== "assistant") throw new Error("wrong role");
+  expect(action.content).toEqual([{ type: "toolCall", id: "call_A", name: "apply_patch", arguments: { input } }]);
+  expect(recovered.context.messages[2]).toMatchObject({ role: "toolResult", isError: true, content: JSON.stringify(result) });
+  const repeated = nativeReceiptRecoveryInput(recovered, recovery, proof);
+  expect(repeated.context.messages).toHaveLength(3);
+  expect(parsed.context.messages).toHaveLength(1);
+  const compiled = compileChatGptWebPrompt(repeated, { localToolsEnabled: true, solAvailable: true, extraHighAvailable: true, proAvailable: true }, recovery.token, { completedNativeReceiptRecovery: true });
+  expect(compiled.text).toContain("distinct subsequent tools may run");
+  expect(compiled.text).toContain("Unknown outcomes stay fenced");
+  expect(compiled.text).not.toContain("Native execution is now closed");
+  expect(() => nativeReceiptRecoveryInput(parsed, recovery, { call_A: "forged" })).toThrow("validation");
+  expect(() => nativeReceiptRecoveryInput(parsed, { ...recovery, receipts: [...recovery.receipts, ...recovery.receipts] }, proof)).toThrow("set failed");
+});
