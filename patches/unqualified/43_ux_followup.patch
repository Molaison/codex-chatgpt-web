+import { mkdtempSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { DurableOperation, OperationJournal, type OperationRecord, type MultipartCheckpoint } from "../src/adapters/chatgpt-web/operation-journal";
+
+function fixture() {
+  const root = mkdtempSync(join(process.env.Q39_TEST_ROOT!, "multipart-"));
+  const journal = new OperationJournal(root);
+  const record: OperationRecord = {version:1,operationId:"op_test",executionKey:"intent_test",traceId:"trace_test",threadId:"thread",turnId:"turn",
+    requestIds:[],submission:"prepared",generation:"not_started",delivery:"attached",recovery:"none",seq:0,attempt:0,updatedAt:Date.now(),rounds:{}};
+  const checkpoint: MultipartCheckpoint = {version:1,identity:{operationId:record.operationId,executionKey:record.executionKey,roundKey:"round",threadId:"thread",turnId:"turn"},
+    traceId:record.traceId,accountId:"account2",modelId:"model",effort:"high",host:{pid:process.pid,instanceId:"h".repeat(32),profile:"production",partition:"persist:codex-web-gpt-chatgpt"},
+    lease:{helperPid:process.pid,surfaceId:"s".repeat(32),targetId:"target"},conversation:{key:"conversation",claim:"claim"},transactionId:"transaction",inputHash:"a".repeat(64),totalStages:3,
+    acknowledgedStages:[],pendingStage:{index:1,kind:"stage",phase:"prepared",submittedText:"inert part 1",acknowledgement:"ACK 1",initialTurnIdentities:[]}};
+  return {root,journal,record,checkpoint,operation:new DurableOperation(journal,record)};
+}
+function accept(c: MultipartCheckpoint) {
+  c.pendingStage!.phase = "accepted";
+  Object.assign(c.pendingStage!,{acceptedUserIdentity:"user"+c.pendingStage!.index,assistantIdentity:"assistant"+c.pendingStage!.index,
+    acceptedTurnIdentities:["user"+c.pendingStage!.index,"assistant"+c.pendingStage!.index]});
+}
+function acknowledge(c: MultipartCheckpoint) {
+  const {kind,phase,...pending} = c.pendingStage!;
+  c.acknowledgedStages.push({...pending,acknowledgement:pending.acknowledgement!,acceptedUserIdentity:pending.acceptedUserIdentity!,
+    assistantIdentity:pending.assistantIdentity!,acceptedTurnIdentities:pending.acceptedTurnIdentities!});
+  delete c.pendingStage;
+}
+
+test("multipart durably records each Send/accept/ACK, restart reads pending without dispatch authorization", () => {
+  const f=fixture(), c=f.checkpoint;
