+import { parseRequest } from "../src/responses/parser";
+import { ChatGptThreadEnvironmentStore } from "../src/adapters/chatgpt-web/thread-environment";
+
+type Profile = "read-only" | "workspace-write";
+
+function wire(input: {
+  threadId: string;
+  turnId: string;
+  mode: Profile;
+  network: "restricted" | "enabled";
+  cwd: string;
+  roots?: string[];
+}) {
+  const roots = input.roots ?? [input.cwd];
+  const entries = [
+    `<entry access="read"><special>:root</special></entry>`,
+    ...(input.mode === "workspace-write"
+      ? [`<entry access="write"><path>${input.cwd}</path></entry>`]
+      : []),
+  ].join("");
+  const permissions = `<permissions instructions>Filesystem sandboxing defines which files can be read or written. \`sandbox_mode\` is \`${input.mode}\`: Native sandbox. Network access is ${input.network}.\nApproval policy is currently never.</permissions instructions>`;
+  const environment = `<environment_context><cwd>${input.cwd}</cwd><filesystem><workspace_roots>${roots
+    .map(root => `<root>${root}</root>`)
+    .join("")}</workspace_roots><permission_profile type="managed"><file_system type="restricted">${entries}</file_system></permission_profile></filesystem></environment_context>`;
+  return parseRequest({
+    model: "chatgpt-web/high",
+    stream: false,
+    client_metadata: {
+      "x-codex-turn-metadata": JSON.stringify({
+        thread_id: input.threadId,
+        turn_id: input.turnId,
+        sandbox_mode: input.mode,
+        workspaces: { [input.cwd]: { has_changes: true } },
+      }),
+    },
+    input: [
+      { type: "message", role: "developer", id: `msg_permissions_${input.turnId}`,
+        content: [{ type: "input_text", text: permissions }] },
+      { type: "message", role: "user", id: `msg_environment_${input.turnId}`,
+        content: [{ type: "input_text", text: environment }] },
+      { type: "message", role: "user", id: `msg_instruction_${input.turnId}`,
+        content: [{ type: "input_text", text: "Continue in the authorized workspace." }] },
+    ],
+  });
+}
+
+test.each([
+  ["read-only", "restricted", "readOnly", false],
+  ["workspace-write", "restricted", "workspaceWrite", false],
+  ["workspace-write", "enabled", "workspaceWrite", true],
+] as const)("UX08 legal child cwd keeps the current %s/%s profile", (mode, network, policy, enabled) => {
+  const temp = mkdtempSync(join(tmpdir(), "cpr43-ux08-"));
+  const workspace = join(temp, "workspace");
+  const child = join(workspace, "child");
+  const threadId = `thread_ux08_${policy}_${network}`;
