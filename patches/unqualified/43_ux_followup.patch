+import type { MultipartCheckpoint, MultipartPendingStage, MultipartStageIdentity } from "./operation-journal";
+import type { CompiledChatGptWebPrompt } from "./prompt";
+import { createHash } from "node:crypto";
+
+export function multipartInputHash(prepared: Pick<CompiledChatGptWebPrompt, "multipart" | "images" | "files" | "skillFiles">): string {
+  return createHash("sha256").update(JSON.stringify({ multipart: prepared.multipart, images: prepared.images,
+    files: prepared.files ?? [], skillFiles: prepared.skillFiles ?? [] })).digest("hex");
+}
+
+/** Input receipts for the current writer. This object never acquires a lease or sends a message. */
+export class MultipartInputTransaction {
+  private checkpoint: MultipartCheckpoint;
+  constructor(checkpoint: Omit<MultipartCheckpoint, "acknowledgedStages" | "pendingStage">,
+    private readonly write: (checkpoint: MultipartCheckpoint) => void | Promise<void>) {
+    this.checkpoint = { ...checkpoint, acknowledgedStages: [] };
+  }
+  private async save(): Promise<void> { await this.write(structuredClone(this.checkpoint)); }
+  async beforeSend(stage: Omit<MultipartPendingStage, "phase">): Promise<void> {
+    this.checkpoint.pendingStage = { ...stage, phase: "prepared" };
+    await this.save();
+    this.checkpoint.pendingStage.phase = "send_activated";
+    await this.save();
+  }
+  async accepted(evidence: Omit<MultipartStageIdentity, "index" | "submittedText" | "initialTurnIdentities">,
+    conversationUrl?: string): Promise<void> {
+    const pending = this.checkpoint.pendingStage;
+    if (!pending || pending.phase !== "send_activated") throw new Error("Multipart acceptance has no active Send");
+    Object.assign(pending, evidence, { phase: "accepted" });
+    if (conversationUrl) this.checkpoint.conversation.url = conversationUrl;
+    await this.save();
+  }
+  async acknowledged(): Promise<void> {
+    const pending = this.checkpoint.pendingStage;
+    if (!pending || pending.kind !== "stage" || pending.phase !== "accepted" || !pending.acknowledgement
+      || !pending.acceptedUserIdentity || !pending.assistantIdentity || !pending.acceptedTurnIdentities) {
+      throw new Error("Multipart acknowledgement has no accepted stage");
+    }
+    const { kind, phase, ...receipt } = pending;
+    this.checkpoint.acknowledgedStages.push({ ...receipt, acknowledgement: pending.acknowledgement,
+      acceptedUserIdentity: pending.acceptedUserIdentity, assistantIdentity: pending.assistantIdentity,
+      acceptedTurnIdentities: [...pending.acceptedTurnIdentities] });
+    delete this.checkpoint.pendingStage;
+    await this.save();
+  }
+}
