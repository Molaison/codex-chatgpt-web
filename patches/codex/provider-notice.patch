+use serde::Deserialize;
+use serde_json::Value;
+
+#[derive(Debug)]
+pub struct ProviderNotice {
+    pub id: String,
+    pub execution_id: String,
+    pub seq: u64,
+    pub message: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct WireNotice {
+    version: u32,
+    id: String,
+    execution_id: String,
+    seq: u64,
+    kind: NoticeKind,
+    observed_at: String,
+    message: String,
+    source: String,
+    evidence: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum NoticeKind {
+    AccountPinned,
+    AccountChanged,
+    ConversationRestored,
+    ConversationForked,
+    ObserverDetached,
+    Reconnecting,
+    Resumed,
+    ToolWaiting,
+    NeedsReconcile,
+}
+
+pub(crate) fn parse_provider_notice(value: Value) -> Option<ProviderNotice> {
+    let wire: WireNotice = serde_json::from_value(value).ok()?;
+    let lower = wire.message.to_ascii_lowercase();
+    if wire.version != 1
+        || wire.source != "chatgpt-web"
+        || wire.evidence != "observed"
+        || wire.id.is_empty()
+        || wire.execution_id.is_empty()
+        || wire.message.trim().is_empty()
+        || wire.message.chars().count() > 512
+        || wire.message.chars().any(char::is_control)
+        || ["://", "chatgpt.com/", "bearer ", "cookie", "token", "sk-"]
+            .iter()
+            .any(|s| lower.contains(s))
+        || chrono::DateTime::parse_from_rfc3339(&wire.observed_at).is_err()
+    {
+        return None;
+    }
+    let _ = wire.kind;
+    Some(ProviderNotice {
+        id: wire.id,
+        execution_id: wire.execution_id,
+        seq: wire.seq,
+        message: wire.message,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    pub(super) fn notice() -> Value {
+        json!({"version":1,"id":"notice-1","execution_id":"exec-1","seq":1,
+            "kind":"resumed","observed_at":"2026-10-24T08:00:00Z",
+            "message":"已接回原会话","source":"chatgpt-web","evidence":"observed"})
+    }
+
+    #[test]
+    fn provider_notice_accepts_only_observed_supported_contract() {
+        assert!(parse_provider_notice(notice()).is_some());
+        let mut zero = notice();
+        zero["seq"] = json!(0);
+        assert!(parse_provider_notice(zero).is_some());
+        let mut unicode = notice();
+        unicode["id"] = json!("状态/".repeat(200));
+        unicode["execution_id"] = json!("执行/".repeat(200));
+        unicode["message"] = json!("恢".repeat(512));
+        assert!(parse_provider_notice(unicode).is_some());
+        for (key, bad) in [
+            ("version", json!(2)),
+            ("kind", json!("invented")),
+            ("evidence", json!("inferred")),
+            ("source", json!("other")),
+            ("observed_at", json!("not-a-time")),
+        ] {
+            let mut wire = notice();
+            wire[key] = bad;
+            assert!(parse_provider_notice(wire).is_none(), "{key}");
+        }
+    }
+
+    #[test]
+    fn provider_notice_rejects_secrets_urls_controls_and_oversize() {
+        for bad in [
+            "cookie=x".to_owned(),
+            "Bearer secret".into(),
+            "https://chatgpt.com/c/private".into(),
+            "line\nline".into(),
+            "\u{1b}[31mANSI".into(),
+            "x".repeat(513),
+        ] {
+            let mut wire = notice();
+            wire["message"] = json!(bad);
+            assert!(parse_provider_notice(wire).is_none());
+        }
+    }
+}
