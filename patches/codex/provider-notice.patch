+#[derive(Default)]
+pub(crate) struct ProviderNoticeState {
+    last_seq: HashMap<String, u64>,
+    ids: HashSet<(String, String)>,
+}
+
+impl ProviderNoticeState {
+    pub(crate) fn admit(&mut self, execution_id: &str, seq: u64, id: &str) -> bool {
+        if self.ids.contains(&(execution_id.to_owned(), id.to_owned()))
+            || self
+                .last_seq
+                .get(execution_id)
+                .is_some_and(|last| seq <= *last)
+        {
+            return false;
+        }
+        self.last_seq.insert(execution_id.to_owned(), seq);
+        self.ids.insert((execution_id.to_owned(), id.to_owned()));
+        true
+    }
+}
