+"""Same-version CPR namespace handoff. No schema changes, old-target switch or replay.
+
+Production requires its own approved plan, native producer census and a new
+root-owned boot/routing receipt. Isolation never impersonates that root approval.
+"""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+import urllib.request
+
+
+def ns_run(argv, data=None):
+    result = subprocess.run(argv, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            universal_newlines=True, timeout=30)
+    if result.returncode:
+        raise RuntimeError('Namespace native command failed: '+str(argv[:3])+': '+result.stderr[-1000:])
+    return result.stdout.strip()
+
+
+def ns_inspect(identifier):
+    return json.loads(ns_run(['podman','inspect',identifier]))[0]
+
+
+def ns_definition(obj):
+    # Podman consumes pending z/Z relabel flags on first start. The immutable
+    # create argv still binds that policy; mount source/RW/propagation stay exact.
+    mounts=[dict(m,Mode=','.join(x for x in m.get('Mode','').split(',') if x not in ('','z','Z'))) for m in obj['Mounts']]
+    return {k: obj[k] for k in ('Id','Image')} | {'argv':obj['Config']['CreateCommand'], 'mounts':mounts}
+
+
+def ns_identity(obj):
+    return {k:obj['State'][k] for k in ('Pid','StartedAt','Running')}
+
+
+def ns_unit(name):
+    fields=['Id','ActiveState','SubState','MainPID','InvocationID','Requires','FragmentPath']
+    raw=ns_run(['systemctl','--user','show',name]+sum([['-p',f] for f in fields],[]))
+    return dict(line.split('=',1) for line in raw.splitlines() if '=' in line)
+
+
+def ns_transplant(argv, name, pod):
+    """Change only lifecycle/name/network; preserve image, user, config and data meaning."""
+    assert Path(argv[0]).name=='podman' and argv[1] in ('run','create')
+    result=[argv[0],'create'];names=networks=0;i=2
+    while i<len(argv):
+        value=argv[i]
+        if value in ('-d','--detach'):i+=1;continue
+        if value.startswith('--name='):result.append('--name='+name);names+=1
+        elif value=='--name':result+=['--name',name];names+=1;i+=1
+        elif value.startswith(('--network=','--net=','--pod=')):result.append('--pod='+pod);networks+=1
+        elif value in ('--network','--net','--pod'):result.append('--pod='+pod);networks+=1;i+=1
+        else:result.append(value)
+        i+=1
+    assert names==networks==1,'Ambiguous original native name/network definition'
+    return result
+
+
+def ns_ingress(plan, action='status'):
+    command=[plan['ingress']['node'],plan['ingress']['script'],action,plan['ingress']['config']]
+    if action!='status':
+        status=ns_ingress(plan);command+=['new',str(status['generation'])]
+    return json.loads(ns_run(command))
+
+
+def ns_validate(plan, state_dir):
+    assert plan['release_mode']=='cpr_namespace' and plan['schema_change'] is False
+    assert plan['execution_python']=='/usr/bin/python3.11'
+    assert plan['state_policy']=='current-in-place' and plan['rollback_version']=='3.29.1'
+    assert plan['backend_image']==plan['source']['backend']['definition']['Image'], 'Not the current CPR version'
+    assert {b['role'] for b in plan['bridges']}=={'cpa','sub2api','web','full1','full2','pool','wb'} and len(plan['bridges'])==7, 'Freeze all seven bridges'
+    assert plan['pod_create'][:3]==['podman','pod','create'] and '--share=net' in plan['pod_create']
+    assert not any(x in ('--share=all','--pid=host','--privileged') for x in plan['pod_create'])
+    assert plan['publish_binding'].startswith('127.0.0.1:') and plan['publish_binding'].endswith(':8081')
+    assert plan['publish_binding'] in plan['pod_create'], 'Publish only the preserved loopback entry'
+    assert plan['data_mount'] in plan['backend_create'], 'Keep current data mounted, no snapshot restoration'
+    assert plan['backend_image'] in plan['backend_create'] and '--pod='+plan['pod_name'] in plan['backend_create']
+    assert plan['source']['namespace_id'] not in ' '.join(plan['backend_create']), 'New backend still depends on legacy namespace'
+    assert plan['backend_create']==ns_transplant(plan['source']['backend']['definition']['argv'],plan['backend_name'],plan['pod_name']), 'Backend changes more than its namespace/name'
+    for bridge in plan['bridges']:
+        original=plan['source']['bridge_'+bridge['role']]['definition']['argv']
+        assert bridge['create']==ns_transplant(original,bridge['new_name'],plan['pod_name']), 'Bridge target/socket contract changed'
+    assert plan['producer_roles']==[p['role'] for p in plan['producer_probes']], 'Incomplete native producer census'
+    if plan['isolation']:
+        assert plan['activation_authorized'] is False
+        assert Path(state_dir).resolve().is_relative_to(Path(plan['isolation_root']).resolve())
+        assert plan['pod_name'].startswith('cpr-q39-')
+        assert all(b['new_name'].startswith('cpr-q39-') for b in plan['bridges'])
+        assert all(u['path'].startswith(plan['isolation_root']+'/units/') for u in plan['unit_changes'])
+        assert Path(plan['target_unit_path']).parent==Path(plan['isolation_root'])/'units'
+        assert Path(plan['target_unit_path']).name.startswith('cpr-q39-')
