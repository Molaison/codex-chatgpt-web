+            assert identity(hot_identity(hot_inspect(plan['old_container']))) == identity(before['old']), 'Old process changed'
+            assert {name: identity(hot_identity(hot_inspect(name))) for name in plan['database_containers']} == {name: identity(value) for name, value in before['databases'].items()}, 'PG/Redis process changed'
+            if state.get('candidate'):
