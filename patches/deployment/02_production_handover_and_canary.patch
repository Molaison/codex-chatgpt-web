+#!/usr/bin/env python3
+"""Fresh real production Native tool turn and saved continuation; no replay."""
+import argparse, importlib, json, os, secrets, time, tomllib
+from pathlib import Path
+life = importlib.import_module('13_native_lifecycle')
+p = argparse.ArgumentParser()
+p.add_argument('--case', required=True)
+p.add_argument('--source-profile', type=Path, required=True)
+a = p.parse_args()
+root = Path(__file__).resolve().parents[4]
+rel = Path('001_cpr_ywl_deployment/01_upstream_compose_isolated/42_diagnostic_recovery_implementation')
+d = root/'runs'/rel/'159_production_release'/a.case
+d.mkdir(mode=0o700)
+workspace = d/'workspace'
+workspace.mkdir(mode=0o700)
+original = a.source_profile.read_text()
+cfg = tomllib.loads(original)
+provider = cfg['model_provider']
+auth = cfg['model_providers'][provider]['auth']
+assert auth['command'].endswith('/ssh') and '--provider-credential' in auth['args']
+auth['command'] = '/usr/bin/ssh'
+auth['args'] = ['-F', '/xcf26/zpzeng/.ssh/config'] + ['zzp@192.168.233.231' if x == 'ywl' else x for x in auth['args']]
+client = root.parent/'200_process_codex_tools/runs/001_codex_patches/01_ordered_patch_series/01_draft_workflows/19_provider_notice_cli/codex'
+argv = [str(client), '--no-daemon']
+def overrides(v, prefix=''):
+    for key, value in v.items():
+        name = prefix+key
+        if isinstance(value, dict):
+            yield from overrides(value, name+'.')
+        else:
+            yield ['-c', name+'='+json.dumps(value)]
+for pair in overrides(cfg):
+    argv += pair
+argv += ['app-server', '--listen', 'stdio://']
+env = dict(os.environ)
+env.pop('CODEX_SQLITE_HOME', None)
+native = life.Native(argv, d, env)
+nonce = 'PROD'+secrets.token_hex(14).upper()
+(workspace/'proof.txt').write_text(nonce+'\n')
+state = dict(case=a.case, status='starting', native_pid=native.process.pid, provider=provider,
+             base_url=cfg['model_providers'][provider]['base_url'], model=cfg['model'],
+             new_intents_only=True, user_request_replayed=False, turns=[])
+def save():
+    (d/'state.json').write_text(json.dumps(state, ensure_ascii=False, indent=2)+'\n')
+def turn(prompt):
+    offset = native.cursor()
+    value = native.rpc('turn/start', {'threadId':state['thread'], 'input':[{'type':'text','text':prompt}]})
+    identity = value['turn']['id']
+    state['turns'].append({'id':identity,'status':'inProgress'})
+    save()
+    while True:
+        try:
+            done = native.wait(lambda v:v.get('method')=='turn/completed' and v.get('params',{}).get('turn',{}).get('id')==identity,start=offset,timeout=900)
+            break
+        except TimeoutError:
+            state['status']='retained-live-owner'
+            save()
+    h = life.history(native,state['thread'],state['history_mode'])
+    (d/(identity+'-history.json')).write_text(json.dumps(h,ensure_ascii=False)+'\n')
+    current = next(v for v in h if v['id']==identity)
+    commands = [v for v in current['items'] if v.get('type')=='commandExecution']
+    final = [v['text'] for v in current['items'] if v.get('type')=='agentMessage']
+    notices = [e['wire']['params']['message'] for e in native.events[offset:] if e['wire'].get('method')=='warning' and e['wire'].get('params',{}).get('message','').startswith('[ChatGPT]')]
+    item = state['turns'][-1]
+    item.update(status=done['params']['turn']['status'], commands=len(commands), final=final[-1] if final else '',
+                notices=notices, notices_absent_from_history=all(v.removeprefix('[ChatGPT] ') not in json.dumps(h,ensure_ascii=False) for v in notices),
+                error=done['params']['turn'].get('error'))
+    save()
+    assert item['status']=='completed','Production turn failed; no resend'
+    return commands,item
+save()
+try:
+    native.rpc('initialize',{'clientInfo':{'name':'production-recovery162','version':'1'},'capabilities':{'experimentalApi':True}})
+    native.send({'method':'initialized'})
+    t=native.rpc('thread/start',{'model':cfg['model'],'modelProvider':provider,'cwd':str(workspace),'approvalPolicy':'never','sandbox':'workspace-write'})['thread']
+    state.update(thread=t['id'],history_mode=t.get('historyMode','legacy'),status='running')
+    save()
+    commands,item=turn('This is a new authorized capability check, not a retry. Do not delegate, edit files or use network tools. Use exec_command exactly once to run this command in the current directory: rtk proxy cat proof.txt. Reply exactly with the actual complete file content, without Markdown or explanation. Do not guess the value.')
+    assert len(commands)==1 and commands[0].get('exitCode')==0
+    assert commands[0].get('aggregatedOutput','').strip()==nonce and item['final'].strip()==nonce
+    extra='NEXT'+secrets.token_hex(8).upper()
+    commands,item=turn('Do not use tools. Recall the complete proof value you just read. Reply exactly with that value followed by one space and '+extra+'.')
+    assert not commands and item['final'].strip()==nonce+' '+extra
+    assert all(t['notices_absent_from_history'] for t in state['turns'])
+    assert a.source_profile.read_text()==original
+    state.update(status='completed',exact_proof_and_saved_continuation=True,total_exec=1,native_exit=native.close_idle())
+    save()
+    print(json.dumps(state,ensure_ascii=False))
+except Exception as error:
+    state.update(status='failed-or-retained',failure=str(error))
+    save()
+    if native.active or native.pending:
+        native.observe_until_idle()
+    state['native_exit_after_failure']=native.close_idle()
+    save()
+    raise
