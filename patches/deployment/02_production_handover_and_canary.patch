+        proxy = hot_inspect(plan['forward_container'])
+    assert proxy['Image'] == plan['forward_image_id'] and proxy['Config']['CreateCommand'] == forward, 'Forwarder drift'
+    if not proxy['State']['Running']:
+        assert proxy['State']['Status'] == 'created', 'Forwarder exited: reconcile original owner'
+        hot_run(['podman', 'start', plan['forward_container']])
+    for _ in range(180):
+        try:
+            hot_health(plan['new_url'])
+            return hot_identity(hot_inspect(plan['new_container']))
+        except (OSError, AssertionError):
