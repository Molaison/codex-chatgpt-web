+def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+def run(cmd):
+    if subprocess.call(cmd,stdout=log,stderr=log,stdin=subprocess.DEVNULL):raise RuntimeError('Native operation failed; inspect private39 log')
+def inspect(names):return json.loads(subprocess.check_output(['podman','inspect']+names))
+def unit_state(name):return subprocess.check_output(['systemctl','--user','show',name,'--property=ActiveState','--value']).decode().strip()
+def watchdog_state():return unit_state(watchdog_timer) if watchdog_timer else 'not_configured'
+def identities(items):return {x['Name']:{'id':x['Id'],'started':x['State']['StartedAt'],'mounts':x['Mounts']} for x in items}
+def full_api(c,path,post=False):
+    req=urllib.request.Request('http://127.0.0.1:'+str(c['port'])+path,headers={'Authorization':'Bearer '+c['controlToken']},data=b'' if post else None)
+    with urllib.request.urlopen(req,timeout=10) as response:return json.load(response)
+def dependents(gateway_id):
+    ids=subprocess.check_output(['podman','ps','-aq']).decode().split()
+    found=[]
+    for ident in ids:
+        result=subprocess.run(['podman','inspect',ident],stdout=subprocess.PIPE,stderr=log)
+        if result.returncode:
+            if subprocess.call(['podman','container','exists',ident],stdout=log,stderr=log)==1:continue
+            raise RuntimeError('Existing container inspection failed')
+        x=json.loads(result.stdout)[0]
+        if gateway_id in x.get('Dependencies',[]) or x['HostConfig'].get('NetworkMode') in ['container:'+gateway_id,'container:'+gateway]:found.append(x)
+    assert all(x['Name'] in bridges+list(units.values()) for x in found),'Unknown gateway dependent; coordinate owner'
+    return found
+def protected_services():
+    names=subprocess.check_output(['systemctl','--user','list-units','--all','--no-legend','--plain','chatgpt-web*']).decode().splitlines()
+    result={}
+    excluded=set(units)|(set() if manifest.get('preserve') else set(p['unit'] for p in manifest['profiles']))
+    for line in names:
+        name=line.split()[0]
+        if name in excluded:continue
+        result[name]=subprocess.check_output(['systemctl','--user','show',name,'--property=ActiveState,MainPID,ExecMainStartTimestampMonotonic']).decode()
+    return result
+def browser_owners():
+    result={}
+    # Browser parent processes only; normal renderer churn is not a browser restart.
+    for proc in Path('/proc').iterdir():
+        if not proc.name.isdigit():continue
+        try:
+            cmd=(proc/'cmdline').read_bytes().split(b'\0')
+            if cmd and cmd[0].endswith(b'/chrome') and not any(x.startswith(b'--type=') for x in cmd):
+                result[proc.name]=(proc/'stat').read_text().rsplit(')',1)[1].split()[19]
+        except (OSError,IndexError):pass
+    return result
+
+
+def gateway_used_slots():
+    value=gateway_dashboard()['capacityInfo']['usedSlots']
+    assert isinstance(value,int) and not isinstance(value,bool),'Gateway capacity unknown'
+    return value
+
+
+def gateway_dashboard():
+    query=['podman','exec','-i','codex-proxy-rs_postgres_1','sh','-c',
+           'PGPASSWORD="$POSTGRES_PASSWORD" psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"']
+    key=subprocess.check_output(query,input=b'SELECT admin_api_key FROM runtime_settings;').decode().strip()
+    request=urllib.request.Request(globals().get('gateway_api_url','http://127.0.0.1:18082')+'/api/admin/dashboard/summary',headers={'x-api-key':key})
+    with urllib.request.urlopen(request,timeout=10) as response:
+        return json.load(response)['data']
+
+
+def schema_upgrade_status(schema):
+    """Reconcile a lost COMMIT acknowledgement from actual SQLx metadata."""
+    query=['podman','exec','-i','codex-proxy-rs_postgres_1','sh','-c',
+           'PGPASSWORD="$POSTGRES_PASSWORD" psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"']
+    sql="SELECT coalesce(json_agg(t ORDER BY version),'[]'::json) FROM (SELECT version,encode(checksum,'hex') AS checksum,success FROM _sqlx_migrations) t;"
+    rows=json.loads(subprocess.check_output(query,input=sql.encode()).decode())
+    for status in ['before','after']:
+        if rows==schema[status]:return status
+    return 'unknown'
+
+
+def apply_schema_upgrade(plan,output):
+    schema=plan['gateway']['schema_upgrade']
+    assert sha(Path(schema['sql_file']))==schema['sha256'],'Schema transaction artifact drift'
+    current=schema_upgrade_status(schema)
+    if current=='after':return current
+    assert current=='before','Unknown schema; preserve stopped gateway for reconciliation'
+    command=['podman','exec','-i','codex-proxy-rs_postgres_1','sh','-c',
+             'PGPASSWORD="$POSTGRES_PASSWORD" psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"']
+    with Path(schema['sql_file']).open('rb') as source:
+        result=subprocess.call(command,stdin=source,stdout=output,stderr=output)
+    current=schema_upgrade_status(schema)
+    # A successful COMMIT with a lost client acknowledgement is still committed.
+    if current=='after':return current
+    raise RuntimeError('Schema transaction did not commit (native=%s, schema=%s)' % (result,current))
+
+
+# Serial plans use the cold gateway-only engine, never a parallel hot backend.
+# Private frozen inputs: full inspect list, candidate argv JSON, exact file edits,
+# schema-ready evidence and read-only postcheck. Nothing here runs migrations.
+def serial_idle(record,state,checkpoint):
+    data=gateway_dashboard()
+    slots=data['capacityInfo']['usedSlots']
+    assert isinstance(slots,int) and not isinstance(slots,bool) and slots>=0, 'Gateway capacity unknown'
+    records=data['usageRecords']
+    assert isinstance(records,list), 'Gateway recent-request observation unknown'
+    unfinished=set(state.get('known_unfinished_turns',[]))
+    terminal={'succeeded','failed','cancelled','incomplete'}
+    for item in records:
+        # 3.19 does not expose logicalOutcome here. Never infer completion from
+        # disappearance, elapsed time, or a missing outcome/queue field.
+        if 'logicalOutcome' not in item:continue
+        if item['logicalOutcome'] in terminal:unfinished.discard(item['id'])
+        else:unfinished.add(item['id'])
+    state['known_unfinished_turns']=sorted(unfinished)
+    state['serial_idle_checkpoint']={'checkpoint':checkpoint,'observed_at':time.time(),
+        'api_url':gateway_api_url,'used_slots':slots,'known_unfinished_count':len(unfinished),
+        'queue_count_available':False,'queued_requests':None,'admission_fence':False}
+    atomic_json(record,state)
+    return slots==0 and not unfinished
+
+
+def serial_process_start(pid):
+    try:fields=Path('/proc/{}/stat'.format(pid)).read_text().rsplit(')',1)[1].split()
+    except FileNotFoundError:return None
+    return None if fields[0]=='Z' else fields[19]
+
+
+def serial_stopped(record,state):
+    stop=state['serial_stop']
+    current=optional_inspect(stop['container'])
+    assert current and current['Id']==stop['container_id'], 'Stopped backend identity changed; reconcile original stop'
+    assert not current['State']['Running'] and current['State'].get('Status') in ('stopped','exited'), 'Backend has not exited; preserve native stop handle'
+    stop.update(status='stopped',finished_at=time.time(),
+        exit={k:current['State'].get(k) for k in ('ExitCode','FinishedAt','OOMKilled')})
+    state.setdefault('serial_stop_history',[]).append(dict(stop))
+    atomic_json(record,state)
+
+
+def serial_reconcile_stop(record,state):
+    stop=state['serial_stop']
+    assert stop.get('pid'), 'Stop submission uncertain; inspect original owner, do not resubmit'
+    # KillMode=process preserves a native stop child if its Python owner dies.
+    # Rejoin that exact process; neither timeout nor PID reuse authorizes signals.
+    while True:
+        started=serial_process_start(stop['pid'])
+        if started is None:break
+        assert started==stop['process_start'], 'Stop PID reused; reconcile original owner'
+        time.sleep(1)
+    serial_stopped(record,state)
+
+
+def serial_stop(plan,record,state,current,purpose):
+    # Final gate: bounded wait in this owner; never ignore busy, guess idleness or send early.
+    deadline=time.monotonic()+float(plan['idle_wait_seconds'])
+    interval=float(plan.get('idle_poll_seconds',5))
+    while not serial_idle(record,state,purpose+'_stop_recheck'):
+        remaining=deadline-time.monotonic()
+        if remaining<=0:raise RuntimeError('waiting_timeout: gateway busy; no TERM sent, production unchanged; explicitly resume when idle')
+        time.sleep(min(interval,remaining))
+    command=['sh','-c','podman kill --signal TERM "$1" && exec podman wait --condition=stopped "$1"','cpr-serial-stop',current['Id']]
+    receipt=record.parent/'release-job.json'
+    stop={'status':'pending','checkpoint':'waiting_native_stop','purpose':purpose,
+        'container':current['Name'],'container_id':current['Id'],'command':command,
+        'owner_pid':os.getpid(),'owner_unit':json.loads(receipt.read_text())['unit'] if receipt.exists() else None,
+        'requested_at':time.time(),'idle':dict(state['serial_idle_checkpoint']),
+        'approved_brief_disruption':True,'admission_fence':False,
+        'wait_semantics':'TERM-only kill; blocking podman wait --condition=stopped, no deadline, no escalation'}
+    state['serial_stop']=stop
+    atomic_json(record,state)
+    process=subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=log,stderr=log)
+    stop.update(pid=process.pid,process_start=serial_process_start(process.pid))
+    atomic_json(record,state)
+    # No timeout, terminate, kill or replacement. The independent owner waits.
+    stop['returncode']=process.wait()
+    atomic_json(record,state)
+    serial_stopped(record,state)
+
+
+def serial_artifacts(plan):
+    spec=plan['serial_backend']
+    required=[spec['before_inspect'],spec['candidate_command'],spec['schema_ready']['path']]
+    for field in ('postcheck_command','after_start_command','after_recovery_start_command'):
+        command=plan[field]
+        assert isinstance(command,list) and len(command)>=2 and command[0]==plan['execution_python'], 'Freeze the explicit Python hook command'
+        required.append(command[1])
+    for edit in spec['persistent_files']:
+        required.extend(edit[k] for k in ('before_file','after_file') if edit[k] is not None)
+    assert set(required).issubset(spec['artifacts']), 'Serial input is not frozen'
+    for path,digest in spec['artifacts'].items():
+        assert sha(Path(path))==digest, 'Frozen serial artifact changed'
+    evidence=json.loads(Path(spec['schema_ready']['path']).read_text())
+    assert evidence==spec['schema_ready']['expected'] and evidence.get('ready') is True, 'Schema not ready'
+
+
+def serial_definition(item):
+    return dict({key:item[key] for key in ('Id','Image','Mounts','HostConfig')},
+                command=item['Config']['CreateCommand'])
+
+
+def serial_protected(before):
+    expected=before['serial_protected']
+    for name,old in expected.items():
+        current=inspect([name])[0]
+        assert serial_definition(current)==serial_definition(old), 'Protected container definition changed'
+        assert current['State']['StartedAt']==old['State']['StartedAt'] and current['State']['Running']==old['State']['Running'], 'Protected container restarted'
+    for unit,expected in before['serial_units'].items():
+        assert serial_unit(unit)==expected, 'Protected unit restarted'
+
+
+def serial_unit(unit):
+    return subprocess.check_output(['systemctl','--user','show',unit,
+        '--property=ActiveState,MainPID,ExecMainStartTimestampMonotonic']).decode()
+
+
+def serial_namespaces(backend,dependencies):
+    # A stable container ID/SandboxKey does not imply a stable network namespace
+    # after an OOM restart. Check the live kernel namespaces of owned forwarders.
+    for item in [backend]+dependencies:
+        mode=item['HostConfig'].get('NetworkMode','')
+        if not item['State']['Running'] or not mode.startswith('container:'):continue
+        owner=inspect([mode.split(':',1)[1]])[0]
+        assert owner['State']['Running'], 'Network namespace owner is not running'
+        paths=['/proc/{}/ns/net'.format(x['State']['Pid']) for x in (item,owner)]
+        values=subprocess.check_output(['podman','unshare','readlink']+paths).decode().splitlines()
+        assert len(values)==2 and values[0]==values[1], 'Live container network namespace mismatch'
+
+
+def serial_preflight(plan,before):
+    spec=plan['serial_backend']
+    frozen=json.loads(Path(spec['before_inspect']).read_text())
+    frozen={item['Name']:item for item in frozen}
+    old=before['containers'][0]
+    for item in before['containers']+before['dependents']:
+        assert serial_definition(item)==serial_definition(frozen[item['Name']]), 'Frozen container definition drift'
+    command=old['Config']['CreateCommand']
+    assert Path(command[0]).name=='podman' and command[1] in ('run','create'), 'Unsupported original CreateCommand'
+    expected=list(command)
+    index=expected.index(old['Config']['Image'])
+    additions=spec.get('env_add',[])
+    assert additions in ([],['CPR_SCHEMA_PROFILE=ywl-hot-319-328-v1','CPR_ENABLE_SELF_RESTART=false']), 'Unexpected environment change'
+    append=[]
+    for value in additions:
+        name=value.split('=',1)[0]
+        matches=[]
+        position=2
+        while position<index:
+            arg=command[position]
+            if arg in ('-e','--env'):
+                position+=1
+                if command[position].split('=',1)[0]==name:matches.append((position,''))
+            elif arg.startswith('--env=') and arg[6:].split('=',1)[0]==name:
+                matches.append((position,'--env='))
+            position+=1
+        assert len(matches)<=1, 'Duplicate environment declaration'
+        if matches:
+            position,prefix=matches[0]
+            assert '=' in command[position][len(prefix):], 'Environment override requires an explicit original value'
+            expected[position]=prefix+value
+        else:append.extend(['--env',value])
+    expected[index:index+1]=append+[plan['gateway']['image']]
+    candidate=json.loads(Path(spec['candidate_command']).read_text())
+    assert candidate==expected, 'Candidate must preserve original command except image/profile flags'
+    for index,arg in enumerate(command):
+        path=command[index+1] if arg=='--env-file' else (arg.split('=',1)[1] if arg.startswith('--env-file=') else None)
+        if path:assert path in spec['artifacts'], 'Environment file is not frozen'
+    before['candidate_command']=candidate
+    before['serial_protected']={name:frozen[name] for name in spec['protected_containers']}
+    assert set(dbs).issubset(before['serial_protected']), 'Protect PG and Redis explicitly'
+    mode=old['HostConfig'].get('NetworkMode','')
+    if mode.startswith('container:'):
+        provider=inspect([mode.split(':',1)[1]])[0]
+        assert provider['Name'] in before['serial_protected'], 'Protect the provider namespace explicitly'
+    before['serial_units']={unit:serial_unit(unit) for unit in spec['protected_units']}
+    before['serial_files']=[]
+    for edit in spec['persistent_files']:
+        path=Path(edit['path'])
+        old_text=Path(edit['before_file']).read_text() if edit['before_file'] else None
+        new_text=Path(edit['after_file']).read_text()
+        assert (path.read_text() if path.exists() else None)==old_text, 'Persistent file before mismatch'
+        before['serial_files'].append({'path':str(path),'before':old_text,'after':new_text,
+            'mode':path.stat().st_mode & 0o777 if path.exists() else 0o600,'daemon_reload':edit.get('daemon_reload',False)})
+    assert len({item['path'] for item in before['serial_files']})==len(before['serial_files']), 'Duplicate persistent edit'
+    serial_protected(before)
+    serial_namespaces(old,before['dependents'])
+
+
+def serial_files(before,side):
+    # Validate the entire bounded edit set before writing any member. Partial
+    # writes are reconciled from the same private before journal on recovery.
+    for item in before['serial_files']:
+        path=Path(item['path'])
+        current=path.read_text() if path.exists() else None
+        assert current in (item['before'],item['after']), 'Persistent file drift; preserve for reconciliation'
+    for item in before['serial_files']:
+        path=Path(item['path']);value=item[side]
+        if value is None:
+            if path.exists():path.unlink()
+        else:
+            temporary=path.with_name(path.name+'.serial-release.tmp')
+            temporary.write_text(value)
+            temporary.chmod(item['mode'])
+            temporary.replace(path)
+    if any(item['daemon_reload'] for item in before['serial_files']):run(['systemctl','--user','daemon-reload'])
+
+
+def serial_postcheck(plan):
+    serial_frozen_command(plan,'postcheck_command')
+
+
+def serial_frozen_command(plan,field):
+    spec=plan['serial_backend']
+    command=plan[field]
+    assert sha(Path(command[1]))==spec['artifacts'][command[1]], 'Frozen hook changed: '+field
+    result=subprocess.run(command,stdin=subprocess.DEVNULL,stdout=log,stderr=log,
+        timeout=plan.get(field.replace('_command','_timeout_seconds'),60))
+    assert result.returncode==0, 'Serial hook failed; inspect private release log: '+field
