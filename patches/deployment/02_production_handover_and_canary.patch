+"""Expand-only hot branch of the existing coordinated release owner.
+
+Python 3.11 at execution; syntax remains parseable by the legacy 3.6 submitter.
+Never stops a process, restores a database, or replays an accepted request.
+"""
+import importlib.util
+import socket
+import stat
+
+
+def hot_run(command):
+    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            universal_newlines=True)
+    if result.returncode:
+        # Do not emit environment variables or inspect payloads containing credentials.
+        raise RuntimeError('Hot command failed: ' + command[0] + ': ' + result.stderr.strip())
+    return result.stdout.strip()
+
+
+def hot_inspect(name):
+    result = subprocess.run(['podman', 'container', 'exists', name])
+    if result.returncode == 1:
+        return None
+    assert result.returncode == 0, 'Cannot inspect container existence'
+    return json.loads(hot_run(['podman', 'inspect', name]))[0]
+
+
+def hot_identity(item):
+    return {k: item[k] for k in ('Id', 'Image')} | {'started': item['State']['StartedAt']}
+
+
+def hot_boot_id():
+    return Path('/proc/sys/kernel/random/boot_id').read_text().strip()
+
+
+def hot_health(url):
+    with urllib.request.urlopen(url + '/healthz', timeout=3) as response:
+        assert response.status == 204, 'Hot readiness failed'
+
+
+def hot_control(plan, action='status', target=None):
+    command = [plan['node'], plan['ingress_script'], action, plan['ingress_config']]
+    if target:
+        state = hot_control(plan)
+        command += [target, str(state['generation'])]
+    return json.loads(hot_run(command))
+
+
+def hot_schema_module(plan):
+    spec = importlib.util.spec_from_file_location('hot_schema', plan['schema_script'])
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def hot_verify_files(plan):
+    for path, expected in plan['artifacts'].items():
+        assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == expected, 'Frozen hot artifact changed: ' + path
+    joint = []
+    for item in plan['acceptance']:
+        evidence = json.loads(Path(item['path']).read_text())
+        assert evidence.get('status') == 'completed', 'Acceptance is incomplete: ' + item['path']
+        if item.get('purpose') == 'joint':
+            joint.append(evidence)
+            assert evidence['new_image_id'].removeprefix('sha256:') == plan['image_id'].removeprefix('sha256:'), 'Joint acceptance used another candidate'
+            assert evidence['old_image_id'].removeprefix('sha256:') == plan['old_image_id'].removeprefix('sha256:'), 'Joint acceptance used another old image'
+            assert evidence['database'].startswith('cpr_upgrade28_'), 'Joint acceptance must use an isolated database'
+            for key in ('ingress_script', 'acceptance_script', 'schema_sql'):
+                path = plan[key]
+                artifact = evidence['artifacts'][Path(path).name]
+                assert artifact['path'] == path and artifact['sha256'] == plan['artifacts'][path], 'Joint acceptance artifact mismatch: ' + key
+    assert len(joint) == 1, 'Exactly one frozen joint acceptance is required'
+    image = json.loads(hot_run(['podman', 'image', 'inspect', plan['image']]))[0]
+    assert image['Id'].removeprefix('sha256:') == plan['image_id'].removeprefix('sha256:'), 'Hot image changed'
+
+
+def hot_bootstrap_fingerprint(plan, fingerprint):
+    """Reuse only identical installed routing, not an earlier schema decision."""
+    reference_path = plan.get('bootstrap_reference_plan')
+    if reference_path:
+        raw = Path(reference_path).read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == plan['artifacts'][reference_path], 'Bootstrap reference changed'
+        reference = json.loads(raw)
+        for key in ('bootstrap_unit', 'bootstrap_token', 'bootstrap_receipt', 'bootstrap_helper',
+                    'bootstrap_task', 'ingress_config', 'ingress_unit', 'ingress_script',
+                    'ingress_host', 'ingress_port', 'ingress_url', 'old_url', 'new_url',
+                    'old_container', 'old_id', 'old_image_id', 'new_container', 'image', 'image_id',
+                    'forward_container', 'forward_image_id', 'server_port', 'forward_port', 'node'):
+            assert plan.get(key) == reference.get(key), 'Bootstrap routing changed: ' + key
+        for key in ('bootstrap_helper', 'bootstrap_task'):
+            assert plan['artifacts'][plan[key]] == reference['artifacts'][reference[key]], 'Bootstrap code changed'
+        return hashlib.sha256(json.dumps(reference, sort_keys=True).encode()).hexdigest()
+    return fingerprint
+
+
+def hot_bootstrap_receipt(plan, fingerprint):
+    """Trust only this boot's root-owned receipt, not a user-written success flag."""
+    path = Path(plan['bootstrap_receipt'])
+    if not path.exists():
+        return None
+    for entry in (path,) + tuple(path.parents):
+        info = entry.lstat()
+        assert not stat.S_ISLNK(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022, 'Unsafe root bootstrap receipt'
+    assert path.is_file(), 'Bootstrap receipt is not a regular file'
+    receipt = json.loads(path.read_text())
+    expected = hot_bootstrap_fingerprint(plan, fingerprint)
+    assert receipt['token'] == plan['bootstrap_token'] and receipt['plan_sha256'] == expected, 'Bootstrap receipt belongs to a different plan'
+    assert receipt['helper_sha256'] == plan['artifacts'][plan['bootstrap_helper']], 'Bootstrap helper mismatch'
+    assert receipt['boot_id'] == hot_boot_id(), 'Bootstrap receipt is from a different boot'
+    assert receipt['unit'] == plan['bootstrap_unit'], 'Bootstrap root owner changed'
+    assert receipt['status'] == 'active' and receipt['nft']['state'] == 'active', 'Bootstrap redirect is not active'
+    return receipt
+
+
+def hot_catalog_signature(schema, database, container):
+    """Schema metadata only: never configuration values or credential material."""
+    value = schema.sql("select coalesce(json_agg(x order by name),'[]') from ("
+        "select c.relname name, jsonb_build_object('kind',c.relkind,'columns',"
+        "(select jsonb_agg(jsonb_build_array(a.attname,format_type(a.atttypid,a.atttypmod),a.attnotnull,"
+        "pg_get_expr(d.adbin,d.adrelid)) order by a.attnum) from pg_attribute a left join pg_attrdef d "
+        "on d.adrelid=a.attrelid and d.adnum=a.attnum where a.attrelid=c.oid and a.attnum>0 and not a.attisdropped),"
+        "'constraints',(select jsonb_agg(jsonb_build_array(conname,pg_get_constraintdef(oid)) order by conname) "
+        "from pg_constraint where conrelid=c.oid)) definition from pg_class c join pg_namespace n on n.oid=c.relnamespace "
+        "where n.nspname='public' and c.relkind in ('r','v','S')) x;", database, container)
+    return hashlib.sha256(json.dumps(json.loads(value), sort_keys=True).encode()).hexdigest()
+
+
+def hot_reuse_installed(plan, directory, fingerprint):
+    """Adopt a rolled-back installation, never its old authorization or owner."""
+    source = Path(plan['ingress_config']).resolve().parents[1]
+    assert source != directory.resolve(), 'Recutover requires a new window record'
+    view = release_job_state(source)
+    previous, job = view['record'], view['job']
+    assert previous['status'] == 'rolled_back', 'Installed release is not rolled back'
+    assert previous['plan_sha256'] == fingerprint, 'Installed plan changed'
+    assert job and not _job_live(job['unit_state']) and job['status'] == 'completed', 'Installed release owner is not terminal'
+    assert job['plan_sha256'] == fingerprint, 'Installed owner plan changed'
+    required = {'schema_expanded', 'schema_backfilled', 'candidate_started',
+                'stable_ingress_started', 'bootstrap_activated', 'verified'}
+    assert required.issubset(previous['completed_steps']), 'Installation was not fully verified'
+    assert previous['backfill']['ready'], 'Installed backfill is not ready'
+    before = json.loads((source / 'before.json').read_text())
+    return before, {'release_kind': 'recutover', 'installed_state_dir': str(source),
+                    'installed_window': previous['authorized_window'],
+                    'candidate': previous['candidate']}
+
+
+def hot_installed_ready(plan, fingerprint):
+    receipt = hot_bootstrap_receipt(plan, fingerprint)
+    assert receipt, 'Current-boot bootstrap receipt missing'
+    values = hot_run(['systemctl', 'show', plan['bootstrap_unit'],
+                      '-p', 'ActiveState', '-p', 'Result', '-p', 'ExecMainStatus'])
+    unit = dict(line.split('=', 1) for line in values.splitlines() if '=' in line)
+    assert unit.get('ActiveState') == 'active' and unit.get('Result') == 'success' and unit.get('ExecMainStatus') == '0', 'Root bootstrap owner is not active'
+    schema = hot_schema_module(plan)
+    schema.legacy_history(plan['database'], plan['database_containers'][0])
+    assert schema.sql('select profile from cpr_schema_compat where singleton and ready;',
+                      plan['database'], plan['database_containers'][0]) == schema.PROFILE, 'Installed schema is not ready'
+    for name in [plan['old_container'], plan['new_container']] + plan['database_containers']:
+        assert hot_inspect(name)['State']['Running'], 'Installed process is not running: ' + name
+    for url in (plan.get('old_url', 'http://127.0.0.1:18082'), plan['new_url'],
+                plan.get('ingress_url', 'http://127.0.0.1:18088')):
+        hot_health(url)
+    return receipt
+
+
+def hot_ingress_socket(config):
+    # Linux sun_path includes its terminator (108 bytes). Release paths can
+    # exceed that limit; libuv may silently truncate them before chmod fails.
+    name = hashlib.sha256(str(Path(config).resolve()).encode()).hexdigest()[:20]
+    return '/run/user/{}/cpr-hot-{}.sock'.format(os.getuid(), name)
+
+
+def hot_start_ingress(plan):
+    config = Path(plan['ingress_config'])
+    expected = {'host': plan.get('ingress_host', '0.0.0.0'), 'port': plan.get('ingress_port', 18088),
+                'targets': {'old': plan.get('old_url', 'http://127.0.0.1:18082'), 'new': plan['new_url']},
+                'initialTarget': 'old', 'auxiliaryOrigin': 'http://127.0.0.1:18087',
+                'auxiliaryLocalAddress': '127.0.0.2',
+                'controlSocket': hot_ingress_socket(config),
+                'stateFile': str(config.parent / 'target.json')}
+    if config.exists():
+        assert json.loads(config.read_text()) == expected, 'Ingress config drift'
+    else:
+        config.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        atomic_json(config, expected)
+    unit = Path.home() / '.config/systemd/user' / plan['ingress_unit']
+    content = ('[Unit]\nDescription=CPR stable hot ingress (do not restart active streams)\n'
+               'Requires=' + plan['boot_unit'] + '\nAfter=network.target ' + plan['boot_unit'] + '\n[Service]\nType=simple\nUMask=0077\n'
+               'ExecStart=' + plan['node'] + ' ' + plan['ingress_script'] + ' serve ' + str(config) + '\n'
+               'Restart=on-failure\nRestartSec=2\nTimeoutStopSec=infinity\n'
+               '[Install]\nWantedBy=default.target\n')
+    if unit.exists():
+        assert unit.read_text() == content, 'Ingress unit drift'
+    else:
+        unit.parent.mkdir(parents=True, exist_ok=True)
+        unit.write_text(content)
+        hot_run(['systemctl', '--user', 'daemon-reload'])
+    hot_run(['systemctl', '--user', 'enable', '--now', plan['ingress_unit']])
+    for _ in range(30):
+        try:
+            return hot_control(plan)
+        except (OSError, RuntimeError):
+            time.sleep(1)
+    raise RuntimeError('Ingress control did not become ready')
+
+
+def hot_install_boot(plan, state_dir):
+    """Persist the validated start-only chain; never recreate the old namespace."""
+    directory = Path(state_dir)
+    definitions = {plan[key]: hot_inspect(plan[key])['Config']['CreateCommand']
+                   for key in ('new_container', 'forward_container')}
+    definition_path = directory / 'boot-definitions.json'
+    if definition_path.exists():
+        assert json.loads(definition_path.read_text()) == definitions, 'Boot definitions drift'
+    else:
+        atomic_json(definition_path, definitions)
+    boot = {key: plan[key] for key in ('old_container', 'old_id', 'old_image_id', 'new_container',
+             'image_id', 'forward_container', 'forward_image_id', 'boot_script')}
+    boot['boot_definitions'] = str(definition_path)
+    if plan.get('old_pod_id'):
+        boot['old_pod_id'] = plan['old_pod_id']
+    boot['boot_hashes'] = {'boot_script': plan['artifacts'][plan['boot_script']],
+                          'boot_definitions': hashlib.sha256(definition_path.read_bytes()).hexdigest()}
+    path = directory / 'boot-plan.json'
+    if path.exists():
+        assert json.loads(path.read_text()) == boot, 'Boot plan drift'
+    else:
+        atomic_json(path, boot)
+    digest = hashlib.sha256(path.read_bytes()).hexdigest()
+    unit = Path.home() / '.config/systemd/user' / plan['boot_unit']
+    requires = plan.get('boot_requires', 'codex-proxy-rs.service')
+    content = ('[Unit]\nDescription=CPR frozen hot backend boot owner\n'
+               'Requires=' + requires + '\nAfter=' + requires + '\n'
+               '[Service]\nType=oneshot\nRemainAfterExit=yes\nKillMode=process\nUMask=0077\n'
+               'ExecStart=' + plan.get('execution_python', '/usr/bin/python3.11') + ' ' + plan['boot_script'] + ' ' + str(path) + ' ' + digest + '\n'
+               'TimeoutStartSec=300\n[Install]\nWantedBy=default.target\n')
+    if unit.exists():
+        assert unit.read_text() == content, 'Hot boot unit drift'
+    else:
+        unit.parent.mkdir(parents=True, exist_ok=True)
+        unit.write_text(content)
+        hot_run(['systemctl', '--user', 'daemon-reload'])
+    hot_run(['systemctl', '--user', 'enable', '--now', plan['boot_unit']])
+
+
+def hot_candidate(plan, original, state_dir):
+    """Reuse approved DB/Redis URLs in a private env file; no secrets in argv/logs."""
+    directory = Path(state_dir)
+    env = dict(value.split('=', 1) for value in original['Config']['Env'])
+    # Only the server's explicit runtime variables, not host/container metadata.
+    env = {key: value for key, value in env.items() if key.startswith('CPR_') or key in ('TZ', 'HOME')}
+    server_port = str(plan.get('server_port', 8081))
+    env.update(CPR_SCHEMA_PROFILE='ywl-hot-319-328-v1', CPR_ENABLE_SELF_RESTART='false',
+               CPR_SERVER_HOST='0.0.0.0', CPR_SERVER_PORT=server_port)
+    envfile = directory / 'candidate.env'
+    text = ''.join(key + '=' + value + '\n' for key, value in sorted(env.items()))
+    assert all('\n' not in value and '\r' not in value for value in env.values())
+    if envfile.exists():
+        assert envfile.read_text() == text, 'Candidate runtime environment drift'
+    else:
+        envfile.write_text(text)
+        envfile.chmod(0o600)
+    pod = original.get('Pod')
+    if plan.get('old_pod_id'):
+        assert pod == plan['old_pod_id'], 'Original pod identity changed'
+    command = ['podman', 'create', '--name', plan['new_container']]
+    if pod:
+        command += ['--pod', pod]
+    command += [
+               '--label', 'ywl.cpr.hot.profile=ywl-hot-319-328-v1',
+               '--network', 'container:' + original['Id'], '--env-file', str(envfile),
+               '--security-opt', 'no-new-privileges:true', '--cap-drop', 'ALL',
+               '--tmpfs', '/tmp:size=64m,mode=1777', '-u', '10001:10001',
+               '--restart', 'unless-stopped', '--init',
+               '-v', plan.get('deployment_root', '/home/zzp/codex-proxy-rs') + '/deploy/config.yaml:/app/deploy/config.yaml:ro,z',
+               '-v', str(directory / 'data') + ':/app/.runtime/data:z',
+               '-v', str(directory / 'logs') + ':/app/.runtime/logs:z', plan['image']]
+    current = hot_inspect(plan['new_container'])
+    if current is None:
+        # Prepare separate persistent local state without changing the old mount labels.
+        for name in ('data', 'logs'):
+            path = directory / name
+            path.mkdir(mode=0o700, exist_ok=True)
+        identity = directory / 'data/identity_hmac_secret'
+        # Container copy is the approved operational path; never print/read the secret.
+        # Freeze a private copy so the new process derives the same lc_ session keys.
+        if not (directory / 'local-state-copied.json').exists():
+            assert (directory / 'data').stat().st_uid == os.getuid(), 'Partial local state ownership: reconcile before retry'
+            assert not identity.exists(), 'Partial identity copy: reconcile before retry'
+            hot_run(['podman', 'cp', plan['old_container'] + ':/app/.runtime/data/identity_hmac_secret', str(identity)])
