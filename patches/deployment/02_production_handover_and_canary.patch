+                health, command = healths[name]
+                before = root / 'before' / name
+                before.mkdir(parents=True, exist_ok=True)
+                for filename in ('config.json', 'models.json'):
+                    install(Path(p['production_home']) / filename, before / filename)
+                dropin = Path(p['dropin_target'])
+                if dropin.exists():
+                    install(dropin, before / 'effort-session-modes.conf')
+                state['profiles'][name] = dict(state='prepared', before_pid=health['pid'], before_command=command, dropin_existed=dropin.exists())
+                save()
+            entry = state['profiles'][name]
+            health, command = observed(p)
