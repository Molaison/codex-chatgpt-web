+"""Approved one-window legacy Web/MCP handover under the existing release job.
+
+Old MCP inventories remain unknown, not zero. No database, route or profile restore.
+New listeners start fenced; pre-traffic failures restore the exact old owners.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import shlex
+import shutil
+import subprocess
+import time
+import urllib.request
+
+
+def lm_unit(name):
+    raw = subprocess.check_output(['systemctl', '--user', 'show', name, '-p',
+        'Id,MainPID,InvocationID,ActiveState,SubState,FragmentPath,DropInPaths,ControlGroup']).decode()
+    return dict(line.split('=', 1) for line in raw.splitlines() if '=' in line)
+
+
+def lm_wait_stopped(item):
+    deadline = time.monotonic() + 20
+    while True:
+        now = lm_unit(item['unit'])
+        if now['MainPID'] == '0' and now['ActiveState'] in ('inactive', 'failed'):
+            group = now.get('ControlGroup', '')
+            processes = []
+            if group:
+                for base in ('/sys/fs/cgroup/systemd', '/sys/fs/cgroup'):
+                    f = Path(base + group) / 'cgroup.procs'
+                    if f.exists():
+                        processes += [pid for pid in f.read_text().split() if Path('/proc/' + pid).exists()]
+            assert not processes, 'Stopped unit retains physical processes: ' + item['unit']
+            break
+        assert time.monotonic() < deadline, 'Stop uncertain: ' + item['unit'] + ': ' + json.dumps(now)
+        time.sleep(1)
+    return now
+
+
+def lm_digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def lm_api(item, path, native=False, post=False):
+    if native:
+        token = Path(item['control']['tokenFile']).read_text().strip()
+    else:
+        token = json.loads((Path(item['home']) / 'config.json').read_text())['controlToken']
+    request = urllib.request.Request('http://127.0.0.1:%d%s' % (item['port'], path),
+        headers={'Authorization': 'Bearer ' + token}, data=b'' if post else None)
+    with urllib.request.urlopen(request, timeout=10) as response:
+        return json.load(response)
+
+
+def lm_validate(plan, state_dir):
+    assert plan['release_mode'] == 'legacy_web_maintenance'
+    assert plan.get('legacy_mcp_maintenance_exception') is True, 'Explicit old-session retirement approval required'
+    assert plan.get('unknown_state_policy') == 'retain-unresolved-no-replay'
+    assert plan['deployment_root'] == '/home/zzp/codex-proxy-rs'
+    assert str(Path(state_dir).resolve()) == plan['state_dir']
