+    expected |= {'chatgpt-web-pooled-qa-%d.service' % n for n in (3, 4)}
+    expected |= {'chatgpt-web-full-%d.service' % n for n in range(1, 5)}
+    expected |= {'chatgpt-web-mcp-%d.service' % n for n in range(1, 5)}
