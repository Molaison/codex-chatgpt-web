+
+    if stage == 'verify' or state.get('runtime_deployment_complete'):
+        assert state.get('runtime_deployment_complete'), 'Runtime deployment incomplete'
+        for p in profiles:
+            name = p['profile']
+            assert state['profiles'][name].get('deployed'), name + ' incomplete'
+            assert sha(Path(p['production_home']) / 'config.json') == p['candidate_hashes']['config']
+            assert sha(Path(p['dropin_target'])) == p['candidate_hashes']['dropin']
+            health, command = observed(p)
+            assert health['status'] == 'ok' and health['accepting_turns'] and candidate_running(p, command), name + ' running artifact/health drift'
+        return state
+
+    if state.get('status') in ('recovery_required', 'rolled_back'):
+        recover()
+        raise RuntimeError('Previous runtime release failed; recovery status: ' + state['status'])
+
+    # A lost restart reply is never permission to restart the old or new PID again.
+    for p in profiles:
+        entry = state['profiles'].get(p['profile'])
+        if entry and entry['state'] in ('restart_intent', 'restarted'):
+            pid, command = process(p)
+            assert pid != entry['before_pid'] and candidate_running(p, command), p['profile'] + ' restart ambiguous; reconcile existing owner'
+            entry['state'] = 'restarted'
+            save()
+
+    deadline = time.monotonic() + manifest.get('idle_wait_seconds', 1800)
+    while True:
