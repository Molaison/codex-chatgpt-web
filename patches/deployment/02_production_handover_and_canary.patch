+"""One role, precreated immutable containers, current data; no request replay.
+
+Production host-unit adoption is deliberately gated, not emulated. This revision
+qualifies the lifecycle only in the explicitly authorized network-none sandbox.
+"""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+
+WEB_ROOT = '/home/zzp/codex-proxy-rs/.runtime/unified-web-recovery-20261022-s01/migration-validation'
+WEB_RECOVERY = {'qa1': 'qa1', 'qa2': 'qa234-pool-recovery',
+                'qa3': 'qa234-pool-recovery', 'qa4': 'qa234-pool-recovery',
+                'full1': 'full1', 'full2': 'full2',
+                'pool': 'qa234-pool-recovery', 'mcp1': 'mcp1', 'mcp2': 'mcp2'}
+
+
+def web_under(path, root=WEB_ROOT):
+    return Path(path).is_absolute() and str(Path(path).resolve()).startswith(str(Path(root).resolve()) + '/')
+
+
+def web_validate_plan(plan, state_dir):
+    if plan.get('owner_adapter') == 'systemd-v1':
+        return native_validate(plan, state_dir, mutation=True)
+    assert plan['release_mode'] == 'web_bundle'
+    assert plan.get('role') in WEB_RECOVERY, 'Exactly one explicit Web role required; CPR/bridge excluded'
+    assert plan.get('isolation') is True and plan.get('activation_authorized') is False, (
+        'Production activation refused: source host-unit adoption/approvals are not frozen')
+    assert plan.get('deployment_root') == '/home/zzp/codex-proxy-rs', 'Use original maintenance lock'
+    assert web_under(state_dir) and str(Path(state_dir).resolve()) == plan['state_dir'], 'Use original isolated state-dir'
+    assert plan.get('execution_python') == '/usr/bin/python3.11', 'Frozen Python 3.11 required'
+    assert plan.get('source_owner') == 'precreated-container', 'Source unit takeover is an unfrozen precondition'
+    assert plan.get('drain_contract') == 'web-health-v1' and plan['role'] not in ('pool', 'mcp1', 'mcp2'), (
+        'Native authenticated drain + HTTP/browser/broker idle contract not qualified for this role')
+    assert plan.get('recovery_runtime_key') == WEB_RECOVERY[plan['role']], 'Cross-role recovery forbidden; pool requires QA2-main'
+    assert plan.get('state_policy') == 'current-in-place', 'No old snapshot/member-array/receipt restoration'
+    assert web_under(plan['data_root']) and web_under(plan['config_file']), 'Synthetic data only'
+    assert plan.get('related_execution_gate') == 'isolated-no-clients', 'Related browser/broker owners unknown'
+    assert web_under(plan['preload_manifest']), 'Preload manifest outside sandbox'
+    manifest = web_manifest(plan)
+    assert plan['candidate_image'] == manifest['candidate_image'], 'Candidate differs from frozen preload manifest'
+    recovery = manifest['recovery_runtimes'][plan['recovery_runtime_key']]
+    assert plan['role'] in recovery['roles'], 'Recovery manifest does not qualify this role'
+    assert web_under(recovery['path']), 'Recovery runtime outside sandbox'
+    containers = plan['containers']
+    assert set(containers) == {'source', 'candidate', 'recovery'}, 'Freeze exact source/candidate/recovery'
+    assert containers['source']['id'] != containers['candidate']['id'], 'Candidate must be independent'
+    assert containers['recovery']['id'] == containers['source']['id'], 'This sandbox restores the role-qualified source, never another lane'
+    for kind, item in containers.items():
+        assert len(item['id']) == 64 and all(c in '0123456789abcdef' for c in item['id']), 'Full immutable container ID required'
+        assert item['role'] == plan['role'], 'Cross-role container forbidden'
+        image = plan['candidate_image'] if kind == 'candidate' else manifest['runtime_host_image']
+        assert item['image'] == image and image.startswith('sha256:') and len(image) == 71, 'Use preloaded immutable image'
+        definition = item['definition']
+        assert definition['Id'] == item['id'] and definition['Image'].removeprefix('sha256:') == image[7:], 'Frozen identity mismatch'
+        cfg, host = definition['Config'], definition['HostConfig']
+        assert cfg['Labels'].get('purpose') == 'web-q38-migration' and cfg['Labels'].get('role') == plan['role'], 'Wrong resource owner'
+        assert host['NetworkMode'] == 'none' and host['UsernsMode'] == 'private' and '--userns=keep-id:uid=1000,gid=1000' in item['create_argv'], 'Isolation requires network=none and keep-id'
+        assert host.get('PidMode', '') not in ('host',) and not host.get('Privileged'), 'No host PID or privileged containers'
+        assert not host.get('PortBindings') and not host.get('Devices') and not host.get('VolumesFrom'), 'No external execution access'
+        assert '1000:0:1' in host['IDMappings']['UidMap'] and '1000:0:1' in host['IDMappings']['GidMap'], 'Actual keep-id mapping drift'
+        assert cfg['CreateCommand'] == item['create_argv'], 'Exact create definition required'
+        mounts = definition['Mounts']
+        assert all(m['Type'] == 'bind' and web_under(m['Source']) for m in mounts), 'No production mounts/sockets'
+        assert [m['Source'] for m in mounts if m['Destination'] == '/state'] == [plan['data_root']], 'Current data mount changed'
+        assert all(m['Destination'] == '/state' or not m['RW'] for m in mounts), 'Only current synthetic data may be writable'
+        assert item['runtime_key'] == ('candidate-image' if kind == 'candidate' else plan['recovery_runtime_key']), 'Recovery runtime mismatch'
+        assert {m['Destination'] for m in mounts} == ({'/state'} if kind == 'candidate' else {'/state', '/role-runtime'}), 'Unqualified code/data mount'
+        runtime_mounts = [m for m in mounts if m['Destination'] == '/role-runtime']
+        if kind == 'candidate':
+            assert not runtime_mounts, 'Candidate code must come from the qualified image'
+            assert cfg['Entrypoint'] == '/opt/codex-chatgpt-web/bin/codex-chatgpt-web', 'Unexpected candidate entrypoint'
+        else:
+            assert len(runtime_mounts) == 1 and runtime_mounts[0]['Source'] == recovery['path'] and not runtime_mounts[0]['RW'], 'Role recovery must mount its exact qualified read-only runtime'
+            assert cfg['Entrypoint'] == '/role-runtime/bin/codex-chatgpt-web', 'Recovery must execute the qualified role runtime'
+    assert plan.get('protected'), 'Freeze the other lane/browser identities'
+    for item in plan['protected']:
+        assert item['id'] not in [c['id'] for c in containers.values()], 'Protected browser/lane cannot be the target'
+    for filename in plan['artifacts']:
+        assert web_under(filename), 'Artifact outside isolated scope'
+
+
+def web_manifest(plan):
+    path = Path(plan['preload_manifest'])
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == plan['preload_manifest_sha256'], 'Preload manifest drift'
+    return json.loads(path.read_text())
+
+
+def web_call(argv):
+    result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=30)
+    if result.returncode:
+        raise RuntimeError('Native command failed (%s): %s' % (result.returncode, result.stderr.strip()))
+    return result.stdout
+
+
+def web_inspect(identifier):
+    return json.loads(web_call(['podman', 'inspect', identifier]))[0]
+
+
+def web_definition(obj):
+    return {k: obj[k] for k in ('Id', 'Image', 'Config', 'HostConfig', 'Mounts', 'ProcessLabel', 'MountLabel')}
+
+
+def web_identity(obj):
+    return {k: obj['State'][k] for k in ('Pid', 'StartedAt', 'Running')}
+
+
+def web_verify(plan):
+    manifest = web_manifest(plan)
+    recovery = manifest['recovery_runtimes'][plan['recovery_runtime_key']]
+    root = Path(recovery['path'])
+    assert root.is_dir() and recovery['files'], 'Qualified recovery runtime missing/empty'
+    files = {str(p.relative_to(root)): p for p in root.rglob('*') if p.is_file()}
+    assert set(files) == set(recovery['files']), 'Role runtime file inventory drift'
+    for name, file in files.items():
+        assert web_under(file.resolve(), root), 'Role runtime symlink leaves qualified bundle'
+        assert hashlib.sha256(file.read_bytes()).hexdigest() == recovery['files'][name], 'Role runtime content drift: ' + name
+    for path, expected in plan['artifacts'].items():
+        assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == expected, 'Static artifact/config drift: ' + path
+    for item in plan['containers'].values():
+        assert web_definition(web_inspect(item['id'])) == item['definition'], 'Container definition/identity drift'
+    for item in plan['protected']:
+        obj = web_inspect(item['id'])
+        assert obj['Config']['Labels'].get('purpose') == 'web-q38-migration', 'Protected identity owner drift'
+        assert web_identity(obj) == item['identity'], 'Other lane/browser identity changed'
+        assert web_definition(obj) == item['definition'], 'Protected browser/lane definition drift'
+
+
+def web_api(plan, item, path):
+    # Only administrative admission control. Never POST a model or replay a turn.
+    assert path in ('/healthz', '/admin/drain', '/admin/resume')
+    code = '''const fs=require('node:fs');const c=JSON.parse(fs.readFileSync('/state/config.json','utf8'));
+const path=process.argv[1];const r=await fetch('http://127.0.0.1:'+c.port+path,
+{method:path==='/healthz'?'GET':'POST',headers:path==='/healthz'?{}:{authorization:'Bearer '+c.controlToken},signal:AbortSignal.timeout(5000)});
+if(!r.ok)throw Error('control HTTP '+r.status);console.log(JSON.stringify(await r.json()));'''
+    return json.loads(web_call(['podman', 'exec', item['id'], '/opt/codex-chatgpt-web/runtime/bun', '-e', code, path]))
+
+
+def web_idle(health, drained=False):
+    assert type(health.get('active_http_turns')) is int and type(health.get('active_browser_turns')) is int, 'Unknown HTTP/browser/broker activity; do not stop'
+    assert health['active_http_turns'] == health['active_browser_turns'] == 0, 'Active requests; preserve original execution'
+    if drained:
+        assert health.get('accepting_turns') is False, 'Admission drain does not hold'
+
+
+def web_health(plan, item):
+    health = web_api(plan, item, '/healthz')
+    assert health.get('status') == 'ok' and health.get('service') == 'codex-chatgpt-web', 'Candidate health failed; preserve current process'
+    assert health.get('mode') == ('full' if plan['role'].startswith('full') else 'browser-only'), 'Runtime role/mode drift'
+    return health
+
+
+def web_stop(plan, item, record, state):
+    obj = web_inspect(item['id'])
+    if not obj['State']['Running']:
+        return
+    if state.get('stop_intent') == item['id']:
+        raise RuntimeError('Original stop acknowledgement still unknown/running; inspect original native state, never resend stop')
+    # Reconcile a lost drain acknowledgement by GET, not a second user request.
+    health = web_health(plan, item)
+    if health.get('accepting_turns') is not False:
+        state['drain_intent'] = item['id']; atomic_json(record, state)
+        web_api(plan, item, '/admin/drain')
+    deadline = time.monotonic() + plan['idle_wait_seconds']
+    while True:
+        health = web_health(plan, item)
+        try:
+            web_idle(health, drained=True)
+            break
+        except AssertionError:
+            if time.monotonic() >= deadline:
+                raise
+            time.sleep(.2)
+    web_verify(plan)
+    web_idle(web_health(plan, item), drained=True)
+    state['stop_intent'] = item['id']; atomic_json(record, state)
+    # Podman 4.9's --time=-1 overflows on this host. Send TERM once, observe
+    # exit, and never escalate to KILL or repeat an uncertain stop on resume.
+    web_call(['podman', 'kill', '--signal=TERM', item['id']])
+    deadline = time.monotonic() + 15
+    while web_inspect(item['id'])['State']['Running']:
+        assert time.monotonic() < deadline, 'Graceful exit unconfirmed; preserve handle, never force stop'
+        time.sleep(.1)
+
+
+def web_start(plan, item):
+    if not web_inspect(item['id'])['State']['Running']:
+        web_verify(plan)
+        web_call(['podman', 'start', item['id']])
+
+
+def release_web(stage, plan, state_dir, window_id=None):
+    if plan.get('owner_adapter') == 'systemd-v1':
+        return release_web_native(stage, plan, state_dir, window_id)
+    web_validate_plan(plan, state_dir)
+    directory = Path(state_dir); record = directory / 'release.json'
+    fingerprint = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
+    state = json.loads(record.read_text()) if record.exists() else {'status': 'not_started'}
+    if record.exists():
+        assert state['plan_sha256'] == fingerprint, 'Plan changed; preserve original execution'
+    if stage == 'status':
+        return {'record': state, 'current': {k: web_identity(web_inspect(v['id'])) for k, v in plan['containers'].items()}}
+    assert stage in ('deploy', 'resume', 'rollback') and window_id, 'Explicit isolated window required'
+    directory.mkdir(parents=True, exist_ok=True)
+    with (Path(plan['deployment_root']) / '.runtime/34_integrated_release.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        if stage == 'deploy':
+            assert not record.exists(), 'Existing record: use status/resume'
+            state = {'status': 'prepared', 'phase': 'prepared', 'direction': 'forward',
+                     'authorized_window': window_id, 'plan_sha256': fingerprint, 'role': plan['role'],
+                     'started_at': time.time(), 'completed_steps': [], 'events': [],
+                     'production_generation_sent': False, 'original_turn_replayed': False,
+                     'data_restored': False}
+            atomic_json(record, state)
+        else:
+            assert record.exists() and state['authorized_window'] == window_id, 'Use original record/window'
+            if stage == 'rollback' and state['status'] != 'rolled_back':
+                state['direction'] = 'rollback'
+                atomic_json(record, state)
+        if state['status'] == 'rolled_back' or (state['status'] == 'completed' and stage != 'rollback'):
+            return state
+        direction = state['direction']
+        origin = plan['containers']['candidate' if direction == 'rollback' else 'source']
+        target = plan['containers']['recovery' if direction == 'rollback' else 'candidate']
+        def accept():
+            deadline = time.monotonic() + 15
+            while True:
+                try:
+                    health = web_health(plan, target)
+                    break
+                except RuntimeError:
+                    if time.monotonic() >= deadline or not web_inspect(target['id'])['State']['Running']:
+                        raise
+                    time.sleep(.2)
+            web_idle(health)
+            if health.get('accepting_turns') is False:
+                web_api(plan, target, '/admin/resume')
+            web_verify(plan)
+            state['health'] = web_health(plan, target)
+        steps = [('verify', lambda: web_verify(plan)),
+                 ('origin_stopped', lambda: web_stop(plan, origin, record, state)),
+                 ('target_started', lambda: web_start(plan, target)), ('healthy', accept)]
+        # Revalidate even completed steps on resume; never infer idle from old evidence.
+        try:
+            web_verify(plan)
+            for name, action in steps:
+                name = direction + '_' + name
+                if name in state['completed_steps']:
+                    continue
+                state.update(status='running', phase=name); atomic_json(record, state)
+                tick = time.monotonic(); action()
+                state['completed_steps'].append(name)
+                state['events'].append({'step': name, 'seconds': round(time.monotonic()-tick, 3), 'at': time.time()})
+                atomic_json(record, state)
+        except BaseException as error:
+            state.update(status='failed', error=str(error), failed_at=time.time())
+            atomic_json(record, state)
+            raise
+        state.update(status='rolled_back' if direction == 'rollback' else 'completed', finished_at=time.time())
+        state.pop('error', None); atomic_json(record, state)
+        return state
