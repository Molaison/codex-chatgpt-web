+def optional_inspect(name):
+    code=subprocess.call(['podman','container','exists',name],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+    if code==1:return None
+    if code!=0:raise RuntimeError('Container existence probe failed')
+    return inspect([name])[0]
