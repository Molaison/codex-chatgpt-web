+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
+                values = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
+                assert result.returncode == 0 or values.get('LoadState') == 'not-found', 'Cannot inspect root bootstrap owner'
+                if values.get('ActiveState') == 'active' and values.get('Result') == 'success' and values.get('ExecMainStatus') == '0':
+                    receipt = hot_bootstrap_receipt(plan, fingerprint)
+                    if receipt:
