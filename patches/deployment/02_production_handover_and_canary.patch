+def atomic_json(path, value):
+    path = Path(path)
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+    temporary.replace(path)
+
+
+def execute_steps(record, steps, state):
+    """Persist intent before effects; step implementations reconcile observed state on retry."""
+    completed = state.setdefault('completed_steps', [])
+    for name, action in steps:
+        if name in completed:
+            continue
+        state.update(phase=name, status='running')
+        atomic_json(record, state)
+        try:
+            action()
+        except BaseException as error:
+            state.update(status='failed', error=str(error))
+            atomic_json(record, state)
+            raise
+        completed.append(name)
+        state.pop('error', None)
+        atomic_json(record, state)
+    state.update(status='completed', phase='completed_window_closed')
+    atomic_json(record, state)
+    return state
+
