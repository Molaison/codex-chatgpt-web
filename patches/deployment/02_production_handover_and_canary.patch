+def wait_for_idle(plan,record,state):
+    """Wait without draining or changing production; persist timeout for explicit resume."""
+    seconds=float(plan['idle_wait_seconds'])
+    interval=float(plan.get('idle_poll_seconds',5))
+    assert seconds>0 and interval>0,'Idle wait and poll must be positive'
+    deadline=time.monotonic()+seconds
+    state.update(status='waiting_idle',phase='waiting_idle')
+    atomic_json(record,state)
+    while True:
+        try:
+            slots=None
+            if not plan.get('runtime_only'):
+                g=inspect([gateway])[0]
+                expected=state.get('availability_recovery_gateway') or {'id':plan['current_production']['gateway_id'],'image':plan['current_production']['gateway_image_id']}
+                assert g['Id']==expected['id'] and g['Image']==expected['image'] and g['State']['Running'],'Gateway drift while waiting'
+                if plan.get('release_mode')=='serial':
+                    idle=serial_idle(record,state,'waiting_idle')
+                    slots=state['serial_idle_checkpoint']['used_slots'] if idle else None
+                else:slots=gateway_used_slots()
+            health=[full_api(json.loads((Path(p['production_home'])/'config.json').read_text()),'/healthz') for p in manifest['profiles']]
+            ready=(slots==0 or plan.get('runtime_only')) and all(h['active_http_turns']==h['active_browser_turns']==0 and h['accepting_turns'] for h in health)
+            state['idle_observation']={'used_slots':slots,'runtimes_idle_accepting':ready}
+            state.pop('idle_probe_error',None)
+            if ready:
+                atomic_json(record,state)
+                return
+        except Exception as error:
+            state['idle_probe_error']=str(error)
+        remaining=deadline-time.monotonic()
+        if remaining<=0:
+            state.update(status='waiting_timeout',phase='waiting_idle')
+            atomic_json(record,state)
+            raise RuntimeError('waiting_timeout: production unchanged; explicitly resume when idle')
+        atomic_json(record,state)
+        time.sleep(min(interval,remaining))
