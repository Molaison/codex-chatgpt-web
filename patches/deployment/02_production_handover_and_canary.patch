+        original = hot_inspect(plan['old_container'])
+        assert original and original['State']['Running'], 'Original gateway must remain running'
+        assert original['Id'] == plan['old_id'] and original['Image'] == plan['old_image_id'], 'Original gateway drift'
+        if record.exists():
+            state = json.loads(record.read_text())
+            assert state['plan_sha256'] == fingerprint and state['authorized_window'] == window_id
+            if stage != 'rollback' and state['status'] in ('completed', 'rolled_back'):
