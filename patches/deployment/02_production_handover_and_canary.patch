+"""Frozen systemd -> preloaded container systemd owner, current data only.
+
+No arbitrary lifecycle commands: systemd owns start/stop, native listener owns
+admission, kernel flock owns the writer. prepare is read-only, including production.
+"""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import time
+import urllib.request
+
+NATIVE_ROOT = '/home/zzp/codex-proxy-rs/.runtime/unified-native-takeover-20261022-s01'
+NATIVE_ZERO = {
+    'web': ['active_http', 'active_http_turns', 'active_browser_turns', 'active_model_catalog'],
+    'pool': ['active_http', 'active_dispatches', 'pending_dispatches', 'pending_history',
+             'active_histories', 'active_receipts', 'active_paper_reads', 'active_paper_recoveries'],
+    'mcp': ['active_http', 'active_requests', 'open_sessions', 'pending_sessions',
+            'active_tool_calls', 'native_continuations', 'uncertain_requests'],
+}
+NATIVE_UNIT_FIELDS = ['Id', 'LoadState', 'FragmentPath', 'DropInPaths', 'ExecStart', 'ExecStop',
+    'WorkingDirectory', 'Restart', 'SendSIGKILL', 'KillMode', 'TimeoutStopUSec',
+    'TriggeredBy', 'Triggers', 'NeedDaemonReload', 'ControlGroup', 'ActiveState',
+    'SubState', 'InvocationID', 'MainPID', 'Job', 'Result', 'KillSignal', 'ExecStopPost']
+
+
+def native_call(argv):
+    done = subprocess.run(argv, capture_output=True, text=True, timeout=20)
+    if done.returncode:
+        raise RuntimeError('Native command failed (%s): %s' % (done.returncode, done.stderr.strip()))
+    return done.stdout
+
+
+def native_unit(name):
+    assert re.fullmatch(r'[A-Za-z0-9_.@-]+\.service', name), 'Explicit service unit required'
+    raw = native_call(['systemctl', '--user', 'show', '--all', name] + ['--property='+p for p in NATIVE_UNIT_FIELDS])
+    values = dict(line.split('=', 1) for line in raw.splitlines() if '=' in line)
+    values.setdefault('ExecStopPost', '')
+    values.setdefault('ExecStop', '')  # systemd 239 omits empty command arrays, even with --all.
+    definition = {key: values[key] for key in NATIVE_UNIT_FIELDS if key not in
+                  ('ControlGroup', 'ActiveState', 'SubState', 'InvocationID', 'MainPID', 'Job', 'Result')}
+    # systemd adds mutable execution timestamps/PIDs to ExecStart; freeze only its command definition.
+    for key in ('ExecStart', 'ExecStop', 'ExecStopPost'):
+        definition[key] = re.sub(r' ; start_time=.*?(?=\s*\})', '', definition[key])
+    files = shlex.split(values['DropInPaths']) + ([values['FragmentPath']] if values['FragmentPath'] else [])
+    definition['files'] = {p: hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in files}
+    identity = {key: values[key] for key in ('InvocationID', 'MainPID', 'ControlGroup')}
+    return {'definition': definition, 'identity': identity, 'state': {key: values[key] for key in
+            ('ActiveState', 'SubState', 'Job', 'Result')}, 'processes': native_cgroup_processes(values['ControlGroup'])}
+
+
+def native_cgroup_processes(group):
+    if not group: return []
+    for base in ('/sys/fs/cgroup/systemd', '/sys/fs/cgroup'):
+        path=Path(base+group)/'cgroup.procs'
+        if path.exists():
+            result=[]
+            for value in path.read_text().split():
+                stat=Path('/proc/'+value+'/stat')
+                if stat.exists() and stat.read_text().split(') ',1)[1][0] != 'Z': result.append(int(value))
+            return result
+    raise RuntimeError('Native cgroup census unavailable; cannot infer stopped')
+
+
+def native_validate(plan, state_dir, mutation=False):
+    assert plan.get('release_mode') == 'web_bundle' and plan.get('owner_adapter') == 'systemd-v1'
+    assert plan.get('role') in WEB_RECOVERY, 'One explicit Web role required'
+    assert plan.get('state_policy') == 'current-in-place', 'Never restore data/receipts/member arrays'
+    assert plan.get('deployment_root') == '/home/zzp/codex-proxy-rs', 'Original maintenance lock required'
+    assert str(Path(state_dir).resolve()) == plan['state_dir'], 'Original state-dir required'
+    assert plan['recovery_runtime_key'] == WEB_RECOVERY[plan['role']], 'Cross-role recovery forbidden; pool requires QA2-main'
+    assert set(plan['owners']) == {'source', 'target'}, 'Freeze precisely source and target owners'
+    assert plan['owners']['source']['unit'] != plan['owners']['target']['unit'], 'Owners must be distinct'
+    assert Path(plan['data_root']).is_absolute() and plan['writer_lock'] == plan['data_root']+'/.writer.lock'
+    assert plan['ingress_census'].get('complete') is True, 'Unknown ingress/queues: native census remains a precondition'
+    assert plan['ingress_census'].get('contract') == 'listener-native-v1', 'Manual idle declarations are not a drain'
+    manifest = web_manifest(plan)
+    assert manifest['candidate_image'] == plan['candidate_image'], 'Image differs from preload manifest'
+    runtime = manifest['recovery_runtimes'][plan['recovery_runtime_key']]
+    assert plan['role'] in runtime['roles'], 'Actual recovery runtime not qualified for role'
+    assert plan['owners']['source']['runtime_path'] == runtime['path'], 'Recovery label must bind actual runtime content'
+    for kind, owner in plan['owners'].items():
+        assert owner['probe']['contract'] == ('mcp' if plan['role'] in ('mcp1', 'mcp2') else 'pool' if plan['role'] == 'pool' else 'web')+'-native-v1'
+        definition = owner['definition']
+        assert definition['LoadState'] == 'loaded' and definition['NeedDaemonReload'] == 'no'
+        assert definition['Restart'] == 'no' and definition['SendSIGKILL'] == 'no', 'No auto restart/forced kill during transfer'
+        assert definition['KillMode'] == 'process', 'Keep independent background owners alive'
+        assert definition['KillSignal'] == '15' and not definition['ExecStopPost'], 'Freeze TERM-only stop without unknown post-stop hooks'
+        stop = definition['ExecStop']
+        assert not stop or (kind == 'source' and '/usr/bin/systemctl --user kill --kill-who=all --signal=TERM '+owner['unit'] in stop), 'Unknown stop hook; freeze native unit signal forwarding first'
+        assert not definition['Triggers'] and not definition['TriggeredBy'], 'Unknown activator: freeze ingress first'
+        assert '/usr/bin/flock --no-fork --exclusive --nonblock '+plan['writer_lock']+' ' in definition['ExecStart'], 'Both units must hold the same native writer lock'
+        if kind == 'source':
+            assert runtime['path']+'/' in definition['ExecStart'], 'Source ExecStart does not use frozen role runtime'
+        else:
+            item = owner['container']
+            assert re.fullmatch(r'[0-9a-f]{64}', item['id']), 'Exact preloaded container ID required'
+            assert '/usr/bin/podman start --attach '+item['id'] in definition['ExecStart'], 'Target must attach exact container under same writer lock'
+            assert item['image'] == plan['candidate_image'] and item['definition']['Image'].removeprefix('sha256:') == item['image'][7:]
+            mounts = item['definition']['Mounts']
+            assert [m['Source'] for m in mounts if m['Destination'] == '/state'] == [plan['data_root']], 'Target must use current data in place'
+    if plan.get('isolation'):
+        assert plan.get('activation_authorized') is False, 'Isolation is not production authorization'
+        assert web_under(state_dir, NATIVE_ROOT+'/web-validation') and web_under(plan['data_root'], NATIVE_ROOT+'/web-validation')
+        assert web_under(runtime['path'], NATIVE_ROOT), 'Isolation cannot execute production recovery runtime'
+        assert all(o['unit'].startswith('web-q39-') for o in plan['owners'].values())
+        item = plan['owners']['target']['container']; host = item['definition']['HostConfig']
+        assert item['definition']['Config']['Labels'].get('purpose') == 'web-q39-native'
+        assert host['NetworkMode'] == 'container:'+plan['owners']['target']['probe']['container_id'], 'Target must share only the owned isolated namespace'
+        assert not host.get('Privileged') and host.get('PidMode') != 'host' and not host.get('PortBindings')
+        assert all(web_under(m['Source'], NATIVE_ROOT) and (m['Destination'] == '/state' or not m['RW']) for m in item['definition']['Mounts'])
+        assert '--userns=container:'+plan['owners']['target']['probe']['container_id'] in item['definition']['Config']['CreateCommand']
+        assert '--userns=keep-id:uid=1000,gid=1000' in plan['owners']['target']['probe']['container_definition']['Config']['CreateCommand'], 'Shared namespace must retain exact qualified keep-id owner'
+        for owner in plan['owners'].values():
+            assert owner['probe']['transport'] == 'container-netns', 'Isolated probes must remain inside owned network=none namespace'
+    elif mutation:
+        assert plan.get('activation_authorized') is True, 'Production activation_authorized=false; new explicit approval required'
+        assert plan.get('approved_window'), 'Production frozen approval window missing'
+    return manifest
+
+
+def native_verify(plan, recovery=False):
+    for path, identity in plan['data_identity'].items():
+        stat = Path(path).stat()
+        assert [stat.st_dev, stat.st_ino] == identity, 'Current data/lock identity drift'
+    manifest = web_manifest(plan)
+    runtime = manifest['recovery_runtimes'][plan['recovery_runtime_key']]
+    root = Path(runtime['path'])
+    actual = {str(p.relative_to(root)): p for p in root.rglob('*') if p.is_file()}
+    assert actual and set(actual) == set(runtime['files']), 'Recovery runtime inventory drift'
+    for name, file in actual.items():
+        assert file.stat().st_mode & 0o222 == 0, 'Recovery runtime is not read-only: '+name
+        assert web_under(file.resolve(), root) and hashlib.sha256(file.read_bytes()).hexdigest() == runtime['files'][name], 'Recovery runtime content drift: '+name
+    for path, digest in plan['artifacts'].items():
+        assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == digest, 'Frozen artifact drift: '+path
+    for owner in plan['owners'].values():
+        assert native_unit(owner['unit'])['definition'] == owner['definition'], 'Persistent unit/ExecStart definition drift: '+owner['unit']
+        if 'container' in owner:
+            obj = web_inspect(owner['container']['id'])
+            if recovery and native_failed_target_exited(owner, obj):
+                pass  # Quarantine a failed OCI create; do not execute its changed definition.
+            else:
+                assert web_definition(obj) == owner['container']['definition'], 'Container definition drift'
+        if owner['probe']['transport'] == 'container-netns':
+            probe = owner['probe']; obj = web_inspect(probe['container_id'])
+            assert web_definition(obj) == probe['container_definition'] and obj['State']['Running'], 'Probe owner drift'
+            assert obj['HostConfig']['NetworkMode'] == 'none' and obj['Config']['Labels'].get('purpose') == 'web-q39-native', 'Probe network/owner not isolated'
+    return {kind: native_unit(owner['unit']) for kind, owner in plan['owners'].items()}
+
+
+def native_probe(owner, action='status'):
+    assert action in ('status', 'drain', 'seal', 'resume')
+    probe = owner['probe']; url = probe['origin']+'/admin/release/'+action
+    if probe['transport'] == 'container-netns':
+        code = '''const fs=require('node:fs');const [origin,key,action,mode]=process.argv.slice(1);
+const r=await fetch(origin+'/admin/release/'+action,{method:action==='status'?'GET':'POST',headers:{authorization:'Bearer '+fs.readFileSync(key,'utf8').trim()},signal:AbortSignal.timeout(3000)});
+if(!r.ok)throw Error('native control HTTP '+r.status);const status=await r.json();if(mode){const h=await (await fetch(origin+'/healthz')).json();if(h.mode!==mode||h.pid!==status.pid)throw Error('Web role/listener identity mismatch');}console.log(JSON.stringify(status));'''
+        status = json.loads(native_call(['podman', 'exec', probe['container_id'], probe['bun'], '-e', code, probe['origin'], probe['token_file'], action, probe.get('mode','')]))
+    else:
+        assert probe['transport'] == 'loopback' and re.fullmatch(r'http://127\.0\.0\.1:[0-9]+', probe['origin'])
+        token = Path(probe['token_file']).read_text().strip()
+        req = urllib.request.Request(url, method='GET' if action == 'status' else 'POST', headers={'Authorization': 'Bearer '+token})
+        with urllib.request.urlopen(req, timeout=4) as response:
+            status = json.load(response)
+        if probe.get('mode'):
+            with urllib.request.urlopen(probe['origin']+'/healthz', timeout=4) as response:
+                health = json.load(response)
+            assert health['mode'] == probe['mode'] and health['pid'] == status['pid'], 'Web role/listener identity mismatch'
+    assert status['contract'] == probe['contract'] and status.get('owner_instance'), 'Native listener identity/contract mismatch'
+    fields = NATIVE_ZERO[probe['contract'].removesuffix('-native-v1')]
+    assert all(type(status.get(k)) is int and status[k] >= 0 for k in fields), 'Unknown native lifecycle counter; cannot stop'
+    assert status['safe_to_stop'] == (status['accepting_new'] is False and all(status[k] == 0 for k in fields)), 'Native stop contract inconsistent'
+    return status
+
+
+def native_lock_owner(plan):
+    stat = Path(plan['writer_lock']).stat()
+    key = '%02x:%02x:%d' % (os.major(stat.st_dev), os.minor(stat.st_dev), stat.st_ino)
+    owners = []
+    for line in Path('/proc/locks').read_text().splitlines():
+        fields = line.split()
+        if len(fields) >= 6 and fields[5] == key and fields[1] == 'FLOCK' and fields[3] == 'WRITE':
+            owners.append(int(fields[4]))
+    return owners
+
+
+def native_failed_target_exited(owner, obj=None):
+    if 'container' not in owner: return False
+    obj = obj or web_inspect(owner['container']['id'])
+    state = obj['State']; unit = native_unit(owner['unit'])
+    return (obj['Id'] == owner['container']['id'] and not state['Running'] and state['Pid'] == 0
+            and obj['Image'].removeprefix('sha256:') == owner['container']['image'].removeprefix('sha256:')
+            and not unit['processes']
+            and unit['identity']['MainPID'] == '0' and unit['state']['ActiveState'] in ('inactive', 'failed')
+            and not (state.get('ConmonPid') and Path('/proc/'+str(state['ConmonPid'])).exists()))
+
+
+def native_assert_owner(plan, owner, observed, expected=None):
+    identity = observed['identity']
+    assert observed['state']['ActiveState'] == 'active' and int(identity['MainPID']) > 0, 'Native unit is not active'
+    if expected is not None:
+        assert identity == expected, 'InvocationID/MainPID owner drift; retain original handle'
+    assert native_lock_owner(plan) == [int(identity['MainPID'])], 'Unique current-data writer not held by unit MainPID'
+    if 'container' in owner:
+        obj=web_inspect(owner['container']['id'])
+        assert obj['State']['Running'] and Path('/proc/'+str(obj['State']['Pid'])).exists(), 'Unit active but container not running'
+    return identity
+
+
+def native_prepare(plan, state_dir):
+    gaps = []
+    try:
+        native_validate(plan, state_dir)
+        units = native_verify(plan)
+        source = plan['owners']['source']
+        native_assert_owner(plan, source, units['source'], source['initial_identity'])
+        assert units['target']['state']['ActiveState'] == 'inactive', 'Target already owns execution'
+        status = native_probe(source)
+        assert status['pid'] in units['source']['processes'], 'Source listener PID not in frozen unit cgroup'
+        assert status['owner_instance'] == source['initial_instance'], 'Source native instance drift'
+    except (AssertionError, RuntimeError, KeyError, OSError) as error:
+        gaps.append(str(error)); units = {}; status = None
