+def release_hot(stage, plan, state_dir, window_id=None):
+    directory = Path(state_dir)
+    record = directory / 'release.json'
+    beforefile = directory / 'before.json'
+    if stage == 'status':
+        state = json.loads(record.read_text()) if record.exists() else {'status': 'not_started'}
