+#!/usr/bin/env python3
+"""协调发布入口。默认只读status；deploy需新用户窗口，resume需原窗口明确批准。
+
+rtk proxy python3 config/001_cpr_ywl_deployment/01_upstream_compose_isolated/14_full_effort_session_modes/15_coordinated_release.py --stage status --plan PLAN.json --state-dir REMOTE_STATE_DIR
+远端Python3.6/systemd239；deploy/resume提交独立用户任务后返回句柄。
+源码、任务回执及日志保存在原state-dir；status只读任务和发布状态。
+不复用历史39回执。已有窗口必须使用原plan/state-dir，不自动迁移历史记录。
+"""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--stage',choices=['status','prepare','deploy','resume','rollback','recutover'],default='status')
+    parser.add_argument('--plan',type=Path,required=True)
+    parser.add_argument('--candidate',help='显式候选目录；必须与plan一致')
+    parser.add_argument('--state-dir',required=True)
+    parser.add_argument('--host',default='ywl')
+    parser.add_argument('--ssh-binary', default='ssh', help='显式原生SSH入口，不修改全局包装器')
+    parser.add_argument('--ssh-config',help='显式SSH配置；不改变默认连接方式')
+    parser.add_argument('--jump-host',help='本次SSH的ProxyJump（例如ywl）；不改全局配置')
+    parser.add_argument('--approved-window',help='用户批准窗口标识；resume须沿用原窗口并明确批准恢复')
+    parser.add_argument('--receipt',type=Path,help='本地新回执路径；不覆盖历史15证据')
+    args=parser.parse_args()
+    if args.stage not in ('status','prepare') and not args.approved_window:parser.error('deploy/resume需要明确批准的窗口 --approved-window')
+    plan=json.loads(args.plan.read_text())
+    if args.candidate and args.candidate!=plan.get('full_runtime',{}).get('candidate'):parser.error('--candidate与plan不一致')
+    here=Path(__file__).resolve().parent
+    source='\n'.join((here/name).read_text() for name in ('release_full.py','release_runtime.py','release_hot.py','release_web.py','release_web_native.py','release_namespace.py','release_legacy_web.py','release_job.py'))
+    if args.stage=='status':
+        invocation='release_job_status('+repr(plan)+','+repr(args.state_dir)+',release,run_full)'
+    elif args.stage=='prepare':
+        if plan.get('owner_adapter') != 'systemd-v1' and plan.get('release_mode') != 'legacy_web_maintenance':parser.error('prepare currently requires web_bundle systemd-v1')
+        invocation='release('+repr(args.stage)+','+repr(plan)+','+repr(args.state_dir)+',run_full)'
+    else:
+        invocation='submit_release_job('+repr(args.stage)+','+repr(plan)+','+repr(args.state_dir)+','+repr(args.approved_window)+','+repr(source)+')'
+    source+='\nprint("RECEIPT="+json.dumps('+invocation+',ensure_ascii=False))\n'
+    # Candidate code is ordinary source; no AST extraction/string patching of another CLI.
+    ssh=['rtk','proxy',args.ssh_binary]+(['-F',args.ssh_config] if args.ssh_config else [])+(['-J',args.jump_host] if args.jump_host else [])
+    python=plan.get('execution_python','/usr/bin/python3.11' if plan.get('release_mode')=='hot' else 'python3')
+    result=subprocess.run(ssh+[args.host,python,'-'],input=source,universal_newlines=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    receipt=None
+    for line in result.stdout.splitlines():
+        if line.startswith('RECEIPT='):receipt=json.loads(line[8:])
+        else:print(line)
+    if receipt is not None:
+        if args.receipt:args.receipt.write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n')
+        print(json.dumps(receipt,ensure_ascii=False,indent=2))
+    if result.stderr:print(result.stderr,end='')
+    return result.returncode
+
+
+if __name__=='__main__':raise SystemExit(main())
