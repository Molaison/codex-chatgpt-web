+            'activation_authorized': plan.get('activation_authorized', False),
+            'preconditions': gaps, 'units': units, 'source_native': status}
+
+
+def native_stop(plan, kind, state, record):
+    owner = plan['owners'][kind]
+    current = native_unit(owner['unit'])
+    intent = state['stop_intents'].get(kind)
+    if kind == 'target' and state['direction'] == 'rollback' and 'forward_accept' not in state['steps'] and kind in state['start_intents'] and native_failed_target_exited(owner):
+        assert not native_lock_owner(plan), 'Failed target still holds writer'
+        state['quarantined_target'] = {'id': owner['container']['id'], 'reason': 'Candidate exited before admission was opened; quarantine failed object and restore only frozen source'}
+        atomic_json(record,state); return
+    if intent:
+        assert current['identity']['InvocationID'] in ('', intent['identity']['InvocationID']), 'Original stop owner changed'
+        # Neither command timeout nor a new worker authorizes resending a stop.
+        if current['state']['ActiveState'] not in ('inactive', 'failed') or current['state']['Job'] not in ('', '0'):
+            raise RuntimeError('Original stop is still pending/unknown; inspect original native Job, never resend stop')
+        assert int(current['identity']['MainPID']) == 0 and not current['processes'] and not native_lock_owner(plan), 'Original writer/descendants have not exited'
+        return
+    expected = state['identities'].get(kind)
+    identity = native_assert_owner(plan, owner, current, expected)
+    status = native_probe(owner)
+    assert status['owner_instance'] == state['instances'].setdefault(kind, status['owner_instance']), 'Native listener owner drift'
+    if status['accepting_new']:
+        state['drain_intent'] = kind; atomic_json(record, state)
+        native_probe(owner, 'drain')
+    deadline = time.monotonic() + plan['idle_wait_seconds']
+    while True:
+        status = native_probe(owner)
+        assert status['owner_instance'] == state['instances'][kind], 'Native drain changed listener owner'
+        state['last_native'] = status; atomic_json(record, state)
+        if status['safe_to_stop']: break
+        if time.monotonic() >= deadline:
+            raise RuntimeError('Native requests/sessions still active; fenced original owner remains alive')
+        time.sleep(.1)
+    sealed = native_probe(owner, 'seal')
+    assert sealed['phase'] == 'sealed' and sealed['safe_to_stop'], 'Native atomic seal did not hold'
+    if 'container' not in owner: assert sealed['pid'] in current['processes'], 'Listener PID not owned by source unit'
+    native_assert_owner(plan, owner, native_unit(owner['unit']), identity)
+    state['stop_intents'][kind] = {'identity': identity, 'at': time.time()}; atomic_json(record, state)
+    native_call(['systemctl', '--user', 'stop', '--no-block', owner['unit']])
+    deadline = time.monotonic()+15
+    while time.monotonic() < deadline:
+        current = native_unit(owner['unit'])
+        container_gone = 'container' not in owner or not Path('/proc/'+str(web_inspect(owner['container']['id'])['State']['Pid'])).exists()
+        if container_gone and current['state']['ActiveState'] in ('inactive', 'failed') and int(current['identity']['MainPID']) == 0 and not current['processes'] and not native_lock_owner(plan):
+            return
+        time.sleep(.1)
+    raise RuntimeError('Original stop still pending; preserve native Job and resume, never resend')
+
+
+def native_start(plan, kind, state, record):
+    owner = plan['owners'][kind]; other = plan['owners']['source' if kind == 'target' else 'target']
+    current = native_unit(owner['unit']); previous = native_unit(other['unit'])
+    if 'container' in other:
+        obj=web_inspect(other['container']['id'])
+        assert not obj['State']['Pid'] or not Path('/proc/'+str(obj['State']['Pid'])).exists(), 'Other container process remains alive'
+    assert previous['state']['ActiveState'] in ('inactive', 'failed') and previous['identity']['MainPID'] == '0' and not previous['processes'], 'Other writer still live'
+    if kind not in state['start_intents']:
+        assert not native_lock_owner(plan) and current['state']['ActiveState'] in ('inactive', 'failed'), 'Unexpected live writer'
+        state['start_intents'][kind] = {'at': time.time(), 'previous_identity': current['identity']}; atomic_json(record, state)
+        native_call(['systemctl', '--user', 'start', '--no-block', owner['unit']])
+    deadline = time.monotonic()+15
+    while time.monotonic() < deadline:
+        current = native_unit(owner['unit'])
+        if current['state']['ActiveState'] == 'active' and native_lock_owner(plan) == [int(current['identity']['MainPID'])] and ('container' not in owner or web_inspect(owner['container']['id'])['State']['Running']):
+            identity = native_assert_owner(plan, owner, current)
+            state['identities'][kind] = identity; atomic_json(record, state)
+            return
+        if current['state']['ActiveState'] == 'failed': break
+        time.sleep(.1)
+    raise RuntimeError('Original start pending/failed; retain native start intent, do not redispatch')
+
+
+
+def native_target_status(owner, unit):
+    identifier = owner['container']['id']
+    obj = web_inspect(identifier)
+    assert obj['Id'] == identifier, 'Frozen target container identity drift'
+    native = obj['State']
+    view = {'id': identifier, **{key: native.get(key) for key in ('Status', 'Running', 'Pid', 'ConmonPid')}}
+    for key, field in (('Pid', 'pid_exists'), ('ConmonPid', 'conmon_pid_exists')):
+        pid = native.get(key)
+        view[field] = None if pid is None else bool(pid) and Path('/proc/'+str(pid)).exists()
+    alive = view['pid_exists'] is True or view['conmon_pid_exists'] is True
+    unit_exited = unit['identity']['MainPID'] == '0' and not unit['processes']
+    view['lifecycle'] = ('unit_exited_container_alive' if unit_exited else 'not_exited') if alive else (
+        'unknown' if view['pid_exists'] is None or view['conmon_pid_exists'] is None else
+        'inspect_running_no_native_pid' if native.get('Running') else 'exited')
+    return view
+
+
+def release_web_native(stage, plan, state_dir, window_id=None):
+    if stage == 'prepare': return native_prepare(plan, state_dir)
+    native_validate(plan, state_dir, mutation=stage != 'status')
+    record = Path(state_dir)/'release.json'
+    state = json.loads(record.read_text()) if record.exists() else {'status': 'not_started'}
+    fingerprint = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
+    if record.exists(): assert state['plan_sha256'] == fingerprint, 'Frozen plan changed; preserve original record'
+    if stage == 'status':
+        units = {k: native_unit(v['unit']) for k,v in plan['owners'].items()}
+        return {'record': state, 'units': units, 'writer_pids': native_lock_owner(plan),
+                'target_container': native_target_status(plan['owners']['target'], units['target'])}
+    assert stage in ('deploy', 'resume', 'rollback') and window_id
+    if not plan.get('isolation'): assert window_id == plan['approved_window'], 'Production window mismatch'
+    Path(state_dir).mkdir(parents=True, exist_ok=True)
+    with (Path(plan['deployment_root'])/'.runtime/34_integrated_release.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        if stage == 'deploy':
+            assert not record.exists(), 'Existing record: resume original owner'
+            prepared = native_prepare(plan, state_dir)
+            assert prepared['status'] == 'prepared', prepared['preconditions']
+            state = {'status':'prepared', 'direction':'forward', 'plan_sha256':fingerprint, 'authorized_window':window_id,
+                     'role':plan['role'], 'started_at':time.time(), 'steps':[], 'events':[], 'stop_intents':{}, 'start_intents':{},
+                     'identities':{'source':plan['owners']['source']['initial_identity']}, 'instances':{'source':plan['owners']['source']['initial_instance']},
+                     'data_restored':False, 'original_turn_replayed':False}
+            atomic_json(record,state)
+        else:
+            assert record.exists() and state['authorized_window'] == window_id, 'Original record/window required'
+            if stage == 'rollback': state['direction'] = 'rollback'
+        if state['status'] == 'rolled_back' or (state['status'] == 'completed' and stage != 'rollback'): return state
+        direction = state['direction']; origin,target = ('target','source') if direction == 'rollback' else ('source','target')
+        def accept():
+            deadline = time.monotonic()+15
+            while True:
+                try: status = native_probe(plan['owners'][target]); break
+                except RuntimeError:
+                    if time.monotonic() >= deadline: raise
+                    time.sleep(.2)
+            native_assert_owner(plan, plan['owners'][target], native_unit(plan['owners'][target]['unit']), state['identities'][target])
+            # Every replacement inherits the sticky fence before serving. Never stop an unhealthy active owner here.
+            unfence = state.get('unfence_intents', {}).get(target)
+            if unfence:
+                assert status['owner_instance'] == unfence, 'Unfence owner changed; preserve original handle'
+                if status['accepting_new']:
+                    return
+            assert status['safe_to_stop'], 'Candidate did not inherit a clean fence; preserve original recovery record'
+            native_verify(plan, recovery=direction=='rollback' and 'forward_accept' not in state['steps'])
+            state['instances'][target] = status['owner_instance']; atomic_json(record,state)
+            state.setdefault('unfence_intents', {})[target] = status['owner_instance']; atomic_json(record,state)
+            native_probe(plan['owners'][target], 'resume')
+        try:
+            native_verify(plan, recovery=direction=='rollback' and 'forward_accept' not in state['steps'])
+            for name, action in [('stop',lambda:native_stop(plan,origin,state,record)), ('start',lambda:native_start(plan,target,state,record)), ('accept',accept)]:
+                step=direction+'_'+name
+                if step in state['steps']: continue
+                state.update(status='running',phase=step); atomic_json(record,state)
+                tick=time.monotonic(); action()
+                state['steps'].append(step); state['events'].append({'step':step,'seconds':round(time.monotonic()-tick,3)})
+                atomic_json(record,state)
+        except BaseException as error:
+            state.update(status='failed',error=str(error),failed_at=time.time()); atomic_json(record,state); raise
+        state.update(status='rolled_back' if direction=='rollback' else 'completed',finished_at=time.time())
+        state.pop('error',None); atomic_json(record,state)
+        return state
