+"""SSH只提交；systemd用户任务持有发布执行。远端Python3.6/systemd239。"""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+
+def _job_save(path, value):
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+    temporary.replace(path)
+
+
+def _job_unit(unit):
+    result = subprocess.run(
+        ['systemctl', '--user', 'show', unit,
+         '--property=LoadState,ActiveState,SubState,Result,MainPID,ExecMainStatus'],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
+    state = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
+    if result.returncode and state.get('LoadState') != 'not-found':
+        raise RuntimeError('Cannot inspect release unit: ' + result.stderr.strip())
+    return state
+
+
+def _job_live(unit):
+    return (unit.get('ActiveState') in ('activating', 'reloading', 'deactivating') or
+            unit.get('ActiveState') == 'active' and unit.get('SubState') != 'exited')
+
+
+def release_job_state(state_dir):
+    """Read durable receipts and native unit state without creating any files."""
+    directory = Path(state_dir)
+    record = directory / 'release.json'
+    receipt = directory / 'release-job.json'
+    state = json.loads(record.read_text()) if record.exists() else {'status': 'not_started'}
+    job = json.loads(receipt.read_text()) if receipt.exists() else None
+    if job:
+        unit = _job_unit(job['unit'])
+        job['unit_state'] = unit
+        if _job_live(unit):
+            job['status'] = 'running'
+        elif unit.get('ActiveState') == 'failed':
+            job['status'] = 'waiting_timeout' if state['status']=='waiting_timeout' else 'failed'
+        elif state['status'] == 'rolled_back' or (state['status'] == 'completed' and job.get('stage') != 'rollback'):
+            job['status'] = 'completed'
+    return {'record': state, 'job': job}
+
+
+def release_job_status(plan, state_dir, release_runner, full_runner):
+    result = release_runner('status', plan, state_dir, full_runner)
+    result['job'] = release_job_state(state_dir)['job']
+    return result
+
+
+def _job_reuse(view, stage, fingerprint, window_id):
+    for identity in (view['record'], view['job']):
+        if identity and 'plan_sha256' in identity:
+            assert identity['plan_sha256'] == fingerprint, 'Plan changed; preserve original execution'
+            assert identity['authorized_window'] == window_id, 'Use the original approved window'
+    if stage == 'rollback':
+        job = view['job']
+        if job:
+            if _job_live(job['unit_state']):
+                return True
+            assert job['status'] in ('completed', 'failed', 'waiting_timeout'), 'Submission uncertain; reconcile the original unit before rollback'
+        return view['record']['status'] == 'rolled_back'
+    if view['record']['status'] in ('completed', 'rolled_back'):
+        return True
+    job = view['job']
+    if job:
+        if _job_live(job['unit_state']) or stage == 'deploy' or job['status'] == 'completed':
+            return True
+        assert job['status'] in ('failed','waiting_timeout'), 'Submission uncertain; reconcile the original unit before resume'
+    return False
+
+
+def submit_release_job(stage, plan, state_dir, window_id, source):
+    assert stage in ('deploy', 'resume', 'rollback', 'recutover') and window_id, 'Mutations require an approved window'
+    assert stage != 'recutover' or plan.get('release_mode') == 'hot', 'Recutover requires a hot installation'
+    assert stage != 'rollback' or plan.get('release_mode') in ('hot', 'web_bundle', 'cpr_namespace', 'legacy_web_maintenance'), 'Rollback requires hot, web_bundle or cpr_namespace plan'
+    if plan.get('release_mode') == 'web_bundle':
+        web_validate_plan(plan, state_dir)
+    if plan.get('release_mode') == 'legacy_web_maintenance':
+        lm_validate(plan, state_dir)
+    directory = Path(state_dir).resolve()
+    fingerprint = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
+    view = release_job_state(directory)
+    # An active worker owns the maintenance lock; duplicate submissions only read its handle.
+    if _job_reuse(view, stage, fingerprint, window_id):
+        return view
+    root = Path(plan.get('deployment_root', '/home/zzp/codex-proxy-rs'))
+    os.umask(0o077)
+    with (root / '.runtime/34_integrated_release.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        view = release_job_state(directory)
+        if _job_reuse(view, stage, fingerprint, window_id):
+            return view
+        if stage in ('deploy', 'recutover'):
+            assert view['record']['status'] == 'not_started' and not (directory / 'before.json').exists(), 'Existing record: use status/resume'
+        else:
+            assert view['job'] or (directory / 'release.json').exists(), 'No resumable record'
+        directory.mkdir(parents=True, exist_ok=True)
+        attempt = view['job']['attempt'] + 1 if view['job'] else 1
+        unit = 'cpr-release-' + hashlib.sha256(str(directory).encode()).hexdigest()[:20] + '-' + str(attempt) + '.service'
+        worker = directory / ('%02d_release_worker.py' % attempt)
+        receipt = directory / 'release-job.json'
+        job = {'unit': unit, 'attempt': attempt, 'stage': stage, 'status': 'submitting',
+               'execution_stage': stage if stage in ('rollback', 'recutover') else ('resume' if (directory / 'release.json').exists() else
+                   ('recutover' if view['job'] and view['job'].get('execution_stage') == 'recutover' else 'deploy')),
+               'authorized_window': window_id, 'plan_sha256': fingerprint,
+               'state_dir': str(directory), 'receipt': str(receipt), 'source': str(worker),
+               'log': str(directory / 'release-job.log'), 'release_log': str(directory / 'release.log'),
+               'submitted_at': time.time()}
+        if plan.get('release_mode') == 'serial':
+            assert plan.get('approved_brief_disruption') is True, 'Serial replacement requires explicit brief-disruption approval'
+            assert plan.get('admission_fence') is False, 'Serial replacement has no admission fence'
+            job.update(approved_brief_disruption=True, admission_fence=False)
+        with worker.open('x') as output:
+            output.write(source + '\nrun_release_job(' + repr(plan) + ',' + repr(str(directory)) +
+                         ',release,run_full)\n')
+        # Reserve the attempt before contacting systemd. A lost acknowledgement never resubmits it.
+        _job_save(receipt, job)
+        # Keep the original failed/submission handle when a later attempt resumes it.
+        _job_save(directory / ('%02d_release_job.json' % attempt), job)
+    # Release the submission lock before starting the worker, which takes the same lock in release().
+    subprocess.check_call(
+        ['systemd-run', '--user', '--unit=' + unit, '--property=Type=simple',
+         '--property=Restart=no', '--property=RemainAfterExit=yes', '--property=KillMode=process', '--property=UMask=0077',
+         plan.get('execution_python', '/usr/bin/python3.11' if plan.get('release_mode') == 'hot' else '/usr/bin/python3'),
+         '-u', str(worker)], stdin=subprocess.DEVNULL)
+    return release_job_state(directory)
+
+
+def run_release_job(plan, state_dir, release_runner, full_runner):
+    directory = Path(state_dir)
+    receipt = directory / 'release-job.json'
+    job = json.loads(receipt.read_text())
+    os.umask(0o077)
+    with Path(job['log']).open('a', buffering=1) as output:
+        sys.stdout.flush()
+        sys.stderr.flush()
+        os.dup2(output.fileno(), 1)
+        os.dup2(output.fileno(), 2)
+        job.update(status='running', worker_pid=os.getpid(), started_at=time.time())
+        _job_save(receipt, job)
+        try:
+            # Stage is frozen on submission; a failed preflight can be explicitly resumed as deploy.
+            result = release_runner(job['execution_stage'], plan, str(directory), full_runner, job['authorized_window'])
+        except BaseException as error:
+            record=directory/'release.json'
+            status=json.loads(record.read_text()).get('status') if record.exists() else None
+            job.update(status='waiting_timeout' if status=='waiting_timeout' else 'failed', error=str(error), finished_at=time.time())
+            _job_save(receipt, job)
+            _job_save(directory / ('%02d_release_job.json' % job['attempt']), job)
+            raise
+        job.update(status='completed', finished_at=time.time())
+        _job_save(receipt, job)
+        _job_save(directory / ('%02d_release_job.json' % job['attempt']), job)
+        print('RECEIPT=' + json.dumps(result, ensure_ascii=False), flush=True)
