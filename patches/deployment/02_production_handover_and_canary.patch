+                        health, command = drained(p)
+                        break
+                except (OSError, ValueError):
+                    pass
+                time.sleep(1)
+            else:
+                raise RuntimeError(name + ' candidate not healthy; recovery requires known idle identity')
+            entry.update(state='deployed', deployed=True, after_pid=health['pid'], health=health)
+            save()
