+        # restore its files or send a second restart while its identity is unknown.
+        pending = [p['profile'] for p in profiles if state['profiles'].get(p['profile'], {}).get('state') == 'restart_intent']
+        if pending:
+            state.update(status='restart_pending', restart_pending=pending)
+            save()
+        else:
+            recover()
+        raise
