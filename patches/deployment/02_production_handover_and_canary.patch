+def release_runtimes(stage,plan,full_runner,window_id,fingerprint,candidate):
+    """Use the same independent owner/lock without touching gateway or catalogs."""
+    record=rt/'release.json'
+    deployment=candidate/'deployment.json'
+    if stage=='status':
+        return {'record':json.loads(record.read_text()) if record.exists() else {'status':'not_started'},
+                'full_release':json.loads(deployment.read_text()) if deployment.exists() else None}
+    os.umask(0o077)
+    rt.mkdir(parents=True,exist_ok=True)
+    with (root/'.runtime/34_integrated_release.lock').open('a') as lock:
+        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+        if stage=='deploy':
+            assert not record.exists() and not deployment.exists(),'Existing record: use status/resume'
+            state={'authorized_window':window_id,'plan_sha256':fingerprint,'phase':'prepared','status':'prepared',
+                   'completed_steps':[],'production_generation_sent':False,'original_turn_replayed':False}
+            atomic_json(record,state)
+        else:
+            assert stage=='resume' and record.exists(),'No resumable record'
+            state=json.loads(record.read_text())
+            assert state['plan_sha256']==fingerprint,'Plan changed; preserve original execution'
+            if state['status']=='completed':return state
+        def deploy():state['full_release']=full_runner('deploy',str(candidate))
+        def verify():state['full_release']=full_runner('verify',str(candidate))
+        try:
+            # Full owns per-profile wait/recovery after its first durable deployment record.
+            if plan.get('idle_wait_seconds',0) and not deployment.exists():wait_for_idle(plan,record,state)
+            return execute_steps(record,[('full_updated',deploy),('verified',verify)],state)
+        except BaseException:
+            if deployment.exists():state['full_release']=json.loads(deployment.read_text())
+            atomic_json(record,state)
+            raise
