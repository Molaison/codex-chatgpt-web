+"""Full安装与目录核对共享实现；远端Python3.6，导入不执行操作。"""
+
+def run_full(stage, candidate_path):
+    
+    import hashlib, http.cookiejar, json, os, subprocess, sys, time, urllib.request
+    from pathlib import Path
+    os.umask(0o077)
+    root=Path(candidate_path)
+    manifest=json.loads((root/'manifest.json').read_text())
+    record=root/'deployment.json'
+    state=json.loads(record.read_text()) if record.exists() else {'profiles':{},'authorization':'User explicitly approved Full1/2 idle update and catalog refresh after isolated acceptance','production_generation_sent':False}
+    def save():
+        tmp=record.with_suffix('.json.tmp')
+        tmp.write_text(json.dumps(state,ensure_ascii=False,indent=2)+'\n');tmp.replace(record)
+    def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
+    def api(c,path,post=False):
+        req=urllib.request.Request('http://127.0.0.1:'+str(c['port'])+path,headers={'Authorization':'Bearer '+c['controlToken']},data=b'' if post else None)
+        with urllib.request.urlopen(req,timeout=10) as response:return json.load(response)
+    def install(src,dest):
+        dest.parent.mkdir(exist_ok=True,parents=True)
+        tmp=dest.with_name(dest.name+'.h5m-install')
+        tmp.write_bytes(src.read_bytes());tmp.chmod(0o600);tmp.replace(dest)
+    
+    if manifest.get('runtime_only'):
+        return _run_runtime_only(stage, root, manifest, state, save, sha, api, install)
+
+    if stage in ['deploy','verify']:
+        assert sha(root/'runtime/app/cli.js')==manifest['build']['runtime_cli_sha256']
+        for item in manifest['runtime_inventory']:
+            p=root/'runtime'/item['path']
+            if item['kind']=='file':assert sha(p)==item['sha256'],str(p)
+            if item['kind']=='symlink':assert os.readlink(str(p))==item['target'],str(p)
+        assert sha(root/'runtime/runtime/bun')==manifest['external_bun_sha256']
+        # 所有未完成profile先核对原态，防止部署半途发现另一profile已漂移。
+        for p in manifest['profiles']:
+            name=p['profile'];home=Path(p['production_home']);candidate=Path(p['candidate_home'])
+            if state['profiles'].get(name,{}).get('deployed'):
+                assert sha(home/'config.json')==p['candidate_hashes']['config']
+                assert sha(home/'models.json')==p['candidate_hashes']['models']
+                assert sha(Path(p['dropin_target']))==p['candidate_hashes']['dropin']
+                pid=int(subprocess.check_output(['systemctl','--user','show',p['unit'],'--property=MainPID','--value']))
+                assert str(root/'runtime/app/cli.js').encode() in Path('/proc/'+str(pid)+'/cmdline').read_bytes(),name+' running artifact drift'
+                continue
+            for filename,key in [('config.json','config'),('models.json','models')]:
+                allowed=[p['before_hashes'][key]]
+                if name in state['profiles']:allowed.append(p['candidate_hashes'][key])
+                assert sha(home/filename) in allowed, name+' file drift'
+            if name not in state['profiles']:
+                assert hashlib.sha256(subprocess.check_output(['systemctl','--user','cat',p['unit']])).hexdigest()==p['before_hashes']['systemd_unit']
+            else:
+                target=Path(p['dropin_target'])
+                before=root/'before'/name/'effort-session-modes.conf'
+                allowed=[p['candidate_hashes']['dropin']]
+                if before.exists():allowed.append(sha(before))
+                # Before installing files, the complete original unit is still acceptable.
+                original_unit=hashlib.sha256(subprocess.check_output(['systemctl','--user','cat',p['unit']])).hexdigest()==p['before_hashes']['systemd_unit']
+                assert original_unit or target.exists() and sha(target) in allowed, name+' unit drift'
+            for f,k in [('config.json','config'),('models.json','models'),('effort-session-modes.conf','dropin')]:assert sha(candidate/f)==p['candidate_hashes'][k]
+        if stage=='verify':
+            assert state.get('runtime_deployment_complete') and all(state['profiles'].get(p['profile'],{}).get('deployed') for p in manifest['profiles']), 'Full deployment incomplete'
+            return state
+        for p in manifest['profiles']:
+            name=p['profile'];home=Path(p['production_home']);candidate=Path(p['candidate_home'])
+            if state['profiles'].get(name,{}).get('deployed'):continue
+            c=json.loads((home/'config.json').read_text())
+            progress=state['profiles'].get(name)
+            if progress and progress['state'] in ['restart_intent','restarted']:
+                # A lost acknowledgement must not restart a potentially accepted new turn.
+                mainpid=int(subprocess.check_output(['systemctl','--user','show',p['unit'],'--property=MainPID','--value']))
+                command=Path('/proc/'+str(mainpid)+'/cmdline').read_bytes() if mainpid else b''
+                assert mainpid!=progress['before_pid'] and str(root/'runtime/app/cli.js').encode() in command, name+' restart ambiguous; reconcile service before resume'
+            else:
+                health=api(c,'/healthz')
+                assert health['active_http_turns']==health['active_browser_turns']==0,'Full busy; existing owner must finish'
+                drained=api(c,'/admin/drain',True)
+                if drained['active_http_turns'] or drained['active_browser_turns']:
+                    api(c,'/admin/resume',True)
+                    raise RuntimeError('A new turn arrived before drain; preserved it and reopened admission')
+                if not progress:
+                    state['profiles'][name]={'state':'drained','before_pid':health['pid'],'drain':drained};save()
+                else:
+                    assert health['pid']==progress['before_pid'],name+' process drift before restart'
+                for f in ['config.json','models.json']:install(candidate/f,home/f)
+                install(candidate/'effort-session-modes.conf',Path(p['dropin_target']))
+                state['profiles'][name]['state']='files_installed';save()
+                subprocess.check_call(['systemctl','--user','daemon-reload'])
+                state['profiles'][name]['state']='restart_intent';save()
+                subprocess.check_call(['systemctl','--user','restart',p['unit']])
+                state['profiles'][name]['state']='restarted';save()
+            for attempt in range(30):
+                try:
+                    health=api(c,'/healthz')
+                    if health['status']=='ok' and health['accepting_turns'] and health['pid']!=state['profiles'][name]['before_pid']:break
+                except (OSError,ValueError):pass
+                time.sleep(1)
+            else:raise RuntimeError(name+' did not become healthy; inspect existing service before recovery')
+            mainpid=int(subprocess.check_output(['systemctl','--user','show',p['unit'],'--property=MainPID','--value']))
+            assert mainpid==health['pid']
+            cmdline=Path('/proc/'+str(mainpid)+'/cmdline').read_bytes().replace(b'\0',b' ').decode()
+            assert str(root/'runtime/app/cli.js') in cmdline,cmdline
+            state['profiles'][name].update(state='deployed',deployed=True,health=health,cmdline=cmdline,config_sha256=sha(home/'config.json'),models_sha256=sha(home/'models.json'),cli_sha256=sha(root/'runtime/app/cli.js'));save()
+            print(json.dumps({'profile':name,'deployed':True,'pid':health['pid']}),flush=True)
+        state['runtime_deployment_complete']=True;save()
+    
+    if stage=='catalog':
+        import yaml
+        assert state.get('runtime_deployment_complete'),'Complete runtime deployment first'
+        config=yaml.safe_load(Path('/home/zzp/codex-proxy-rs/deploy/config.yaml').read_text())
+        base='http://127.0.0.1:18082';headers={'Content-Type':'application/json','Origin':base}
+        opener=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
+        def admin(path,body):
+            with opener.open(urllib.request.Request(base+path,data=json.dumps(body).encode(),headers=headers),timeout=90) as response:r=json.load(response)
+            assert r['code']==200,r.get('message');return r['data']
+        admin('/api/auth/login',dict(mode='admin',username=config['admin']['default_username'],password=config['admin']['default_password']))
+        for p in manifest['profiles']:
+            name=p['profile'];home=Path(p['production_home']);identity=json.loads((home/'public-test.json').read_text())
+            refreshed=admin('/api/admin/accounts/models/refresh',{'accountId':identity['account']})
+            state['profiles'][name]['refresh']={'account':identity['account'],'model_count':len(refreshed['models']),'at':time.time()};save()
+            expected={m['slug']+'-tools':m for m in json.loads((home/'models.json').read_text())['models']}
+            checks=[]
+            for query in ['', '?client_version=0.160.0']:
+                req=urllib.request.Request(base+'/v1/models'+query,headers={'Authorization':'Bearer '+identity['key']})
+                with urllib.request.urlopen(req,timeout=30) as response:body=json.load(response)
+                models=body.get('data',body.get('models',[]));assert isinstance(models,list)
+                tools={m.get('id',m.get('slug')):m for m in models if m.get('id',m.get('slug')) in expected}
+                assert set(tools)==set(expected),'Client directory missing tools models'
+                checks.append({'query':query,'total_models':len(models),'tools_count':len(tools)})
+                if query:
+                    for slug,m in tools.items():
+                        e=expected[slug]
+                        for field in ['context_window','max_context_window','auto_compact_token_limit','effective_context_window_percent','supported_reasoning_levels']:
+                            assert m.get(field)==e.get(field),(slug,field,m.get(field),e.get(field))
+                        # 提示词及工具能力必须与原生产目录一致。
+                        for field in ['base_instructions','model_messages','supports_parallel_tool_calls']:
+                            assert m.get(field)==e.get(field),(slug,field)
+                    checks[-1]['budgets_efforts_instructions_match']=True
+            state['profiles'][name]['client_catalog_checks']=checks;save()
+            print(json.dumps({'profile':name,'catalog':checks}),flush=True)
+        state['status']='deployed_and_catalog_verified';save()
+    return state
+
+
+def _run_runtime_only(stage, root, manifest, state, save, sha, api, install):
+    """Runtime-only transaction; the independent release owner holds the shared lock."""
+    import hashlib
+    import json
+    import os
+    import subprocess
+    import time
+    from pathlib import Path
+
+    assert stage in ('deploy', 'verify'), 'Runtime-only releases never refresh catalogs'
+    profiles = manifest['profiles']
+    state['authorization'] = 'Approved runtime-only idle update; no catalog changes or existing-turn replay'
+    runtimes = {}
+    configs = {}
+
+    def process(p):
+        pid = int(subprocess.check_output(['systemctl', '--user', 'show', p['unit'], '--property=MainPID', '--value']))
+        command = Path('/proc/' + str(pid) + '/cmdline').read_bytes() if pid else b''
+        return pid, command.decode().split('\0')
+
+    def observed(p):
+        health = api(configs[p['profile']], '/healthz')
+        pid, command = process(p)
+        assert health['pid'] == pid and pid > 0, p['profile'] + ' process identity unknown'
+        return health, command
+
+    def idle(health):
+        return health['active_http_turns'] == health['active_browser_turns'] == 0
+
+    def candidate_running(p, command):
+        return str(runtimes[p['profile']] / 'app/cli.js') in command
+
+    def owned(p, health, command):
+        entry = state['profiles'][p['profile']]
+        return ((health['pid'] == entry['before_pid'] and command == entry['before_command']) or
+                (health['pid'] != entry['before_pid'] and candidate_running(p, command) and
+                 health['pid'] == entry.get('after_pid', health['pid'])))
+
+    def drained(p):
+        health, command = observed(p)
+        assert owned(p, health, command), p['profile'] + ' process drift'
+        assert health['status'] == 'ok' and idle(health) and not health['accepting_turns'], p['profile'] + ' drain no longer holds'
+        return health, command
+
+    def resume(p):
+        entry = state['profiles'][p['profile']]
+        health, command = observed(p)
+        # A restored old runtime has a new PID, but must have the saved command.
+        restored = entry['state'] == 'rolled_back' and command == entry['before_command']
+        assert owned(p, health, command) or restored, p['profile'] + ' resume identity unknown'
+        assert health['status'] == 'ok', p['profile'] + ' resume health unknown'
+        if not health['accepting_turns']:
+            health = api(configs[p['profile']], '/admin/resume', True)
+        assert health['status'] == 'ok' and health['accepting_turns'], p['profile'] + ' failed to resume'
+        entry.update(drain_owned=False, final_health=health)
+        save()
+
+    def recover():
+        errors = {}
+        for p in reversed(profiles):
+            name = p['profile']
+            entry = state['profiles'].get(name)
+            if not entry:
+                continue
+            try:
+                changed = entry['state'] not in ('prepared', 'drained', 'rolled_back')
+                if changed:
+                    health, command = observed(p)
+                    rolling = entry['state'].startswith('rollback_')
+                    # Reconcile an interrupted rollback before considering any new restart.
+                    if entry['state'] in ('rollback_restart_intent', 'rollback_restarted'):
+                        assert health['pid'] != entry['rollback_before_pid'] and command == entry['before_command'], name + ' rollback restart ambiguous'
+                        assert health['status'] == 'ok', name + ' restored runtime unhealthy'
+                        entry['state'] = 'rolled_back'
+                        save()
+                    else:
+                        assert owned(p, health, command) or (rolling and command == entry['before_command']), name + ' rollback identity unknown'
+                        assert health['status'] == 'ok' and idle(health), name + ' rollback blocked by busy/unknown runtime'
+                        if health['accepting_turns']:
+                            entry['drain_owned'] = True
+                            save()
+                            api(configs[name], '/admin/drain', True)
+                        # Read again: POST acknowledgement alone does not prove a safe stop.
+                        health, command = drained(p)
+                        current_pid = health['pid']
+                        # models.json was never written; preserve any unrelated drift.
+                        assert sha(Path(p['production_home']) / 'models.json') == p['before_hashes']['models'], name + ' models drift during recovery'
+                        entry['state'] = 'rollback_files'
+                        save()
+                        before = root / 'before' / name
+                        install(before / 'config.json', Path(p['production_home']) / 'config.json')
+                        dropin = Path(p['dropin_target'])
+                        if entry['dropin_existed']:
+                            install(before / 'effort-session-modes.conf', dropin)
+                        elif dropin.exists():
+                            assert sha(dropin) == p['candidate_hashes']['dropin'], name + ' dropin drift during recovery'
+                            dropin.unlink()
+                        subprocess.check_call(['systemctl', '--user', 'daemon-reload'])
+                        if current_pid == entry['before_pid']:
+                            entry['state'] = 'rolled_back'
+                            save()
+                        else:
+                            entry.update(state='rollback_restart_intent', rollback_before_pid=current_pid)
+                            save()
+                            try:
+                                subprocess.check_call(['systemctl', '--user', 'restart', p['unit']])
+                            except Exception as error:
+                                entry['rollback_restart_ack_error'] = repr(error)
+                                save()
+                            for attempt in range(30):
+                                try:
+                                    restored, restored_command = observed(p)
+                                    if restored['status'] == 'ok' and restored['pid'] != current_pid and restored_command == entry['before_command']:
+                                        break
+                                except (OSError, ValueError):
+                                    pass
+                                time.sleep(1)
+                            else:
+                                raise RuntimeError(name + ' rollback restart ambiguous; do not repeat restart')
+                            entry['state'] = 'rolled_back'
+                            save()
+                resume(p)
+            except Exception as error:
+                errors[name] = repr(error)
+                # Reopen admission only for an identified healthy process, never restart it.
+                if entry.get('drain_owned') and entry['state'] not in ('rollback_restart_intent', 'rollback_restarted'):
+                    try:
+                        resume(p)
+                    except Exception as resume_error:
+                        errors[name] += '; resume: ' + repr(resume_error)
+        state.update(status='recovery_required' if errors else 'rolled_back', recovery_errors=errors)
+        save()
+
+    # Validate every bundle and immutable catalog before touching any production file.
+    for p in profiles:
+        name = p['profile']
+        runtime = Path(p.get('runtime_path', str(root / 'runtime')))
+        assert runtime.is_absolute(), name + ' runtime_path must be absolute'
+        runtimes[name] = runtime
+        assert sha(runtime / 'app/cli.js') == p['runtime_cli_sha256'], name + ' CLI drift'
+        for item in p['runtime_inventory']:
+            path = runtime / item['path']
+            assert not Path(item['path']).is_absolute() and '..' not in Path(item['path']).parts
+            if item['kind'] == 'file':
+                assert sha(path) == item['sha256'], str(path)
+            elif item['kind'] == 'symlink':
+                assert os.readlink(str(path)) == item['target'], str(path)
+            else:
+                raise AssertionError('Unknown inventory kind: ' + item['kind'])
+        assert sha(runtime / 'runtime/bun') == p['external_bun_sha256'], name + ' Bun drift'
+        home, candidate = Path(p['production_home']), Path(p['candidate_home'])
+        for filename, key in [('config.json', 'config'), ('models.json', 'models'), ('effort-session-modes.conf', 'dropin')]:
+            assert sha(candidate / filename) == p['candidate_hashes'][key], name + ' candidate drift'
+        assert p['candidate_hashes']['models'] == p['before_hashes']['models'], name + ' models must remain unchanged'
+        assert sha(home / 'models.json') == p['before_hashes']['models'], name + ' models drift'
+        entry = state['profiles'].get(name)
+        original = root / 'before' / name / 'config.json' if entry else home / 'config.json'
+        assert sha(original) == p['before_hashes']['config'], name + ' original config drift'
+        configs[name] = json.loads(original.read_text())
+        replacement = json.loads((candidate / 'config.json').read_text())
+        expected = dict(configs[name], runtimeCommand=replacement['runtimeCommand'])
+        assert replacement == expected, name + ' only runtimeCommand may change'
+        assert replacement['runtimeCommand'] == [str(runtime / 'bin/codex-chatgpt-web')], name + ' runtimeCommand mismatch'
+        allowed = [p['before_hashes']['config']]
+        if entry:
+            allowed.append(p['candidate_hashes']['config'])
+        assert sha(home / 'config.json') in allowed, name + ' production config drift'
+        if not entry:
+            assert hashlib.sha256(subprocess.check_output(['systemctl', '--user', 'cat', p['unit']])).hexdigest() == p['before_hashes']['systemd_unit'], name + ' unit drift'
+        else:
+            before = root / 'before' / name
+            assert sha(before / 'models.json') == p['before_hashes']['models'], name + ' backup models drift'
+            dropin = Path(p['dropin_target'])
+            if dropin.exists():
+                allowed_dropins = [p['candidate_hashes']['dropin']]
+                if entry['dropin_existed']:
