+/** Read-only account-2 probe: compare the original renderer URL with CDP state.
+ * Never navigate, click, send, refresh, or alter a conversation mapping.
+ */
+import fs from "node:fs";
+import { connectLauncherBrowserHost } from "/home/zzp/.migration/window-20261022/42_diagnostic_recovery_qualification/14_e2e_candidate/source/src/launcher-browser-host";
+
+const root = "/home/zzp/.migration/window-20261022/42_diagnostic_recovery_qualification";
+const path = root + "/canary/launcher-2/launcher-core/runtime/launcher-browser.json";
+const initial = JSON.parse(fs.readFileSync(path, "utf8"));
+const original = new Set(Object.keys(initial.surfaceTargets));
+console.log(JSON.stringify({ event: "armed", model_requests: 0, baseline_surfaces: original.size }));
+let connection: Awaited<ReturnType<typeof connectLauncherBrowserHost>> | undefined;
+const deadline = Date.now() + 240_000;
+try {
+  while (Date.now() < deadline) {
+    const descriptor = JSON.parse(fs.readFileSync(path, "utf8"));
+    if (descriptor.pid !== initial.pid) throw Error("Launcher owner changed");
+    if (!connection) {
+      const fresh = Object.keys(descriptor.surfaceTargets).filter(id => !original.has(id));
+      if (fresh.length > 1) throw Error("Competing new browser surfaces");
+      if (fresh.length === 1) {
+        connection = await connectLauncherBrowserHost(path, 10_000, fresh[0], undefined, true);
+        connection.page.on("framenavigated", frame => {
+          if (frame === connection?.page.mainFrame()) {
+            const url = new URL(frame.url());
+            console.log(JSON.stringify({ event: "frame_url", at: Date.now(), origin: url.origin,
+              path: url.pathname, temporary: url.searchParams.get("temporary-chat") === "true" }));
+          }
+        });
+        console.log(JSON.stringify({ event: "bound", at: Date.now(), surface: fresh[0] }));
+      }
+    }
+    if (connection) {
+      if (connection.page.isClosed()) break;
+      const renderer = await connection.page.evaluate(() => ({
+        origin: location.origin, path: location.pathname,
+        temporary: new URL(location.href).searchParams.get("temporary-chat") === "true",
+        ready: document.readyState,
+        users: document.querySelectorAll('[data-message-author-role="user"]').length,
+        assistants: document.querySelectorAll('[data-message-author-role="assistant"]').length,
+      }));
+      const cdp = new URL(connection.page.url());
+      console.log(JSON.stringify({ event: "snapshot", at: Date.now(), renderer,
+        cdp: { origin: cdp.origin, path: cdp.pathname, temporary: cdp.searchParams.get("temporary-chat") === "true" } }));
+    }
+    await Bun.sleep(500);
+  }
+} finally {
+  await connection?.browser.close();
+  console.log(JSON.stringify({ event: "detached", at: Date.now(), model_requests: 0 }));
+}
